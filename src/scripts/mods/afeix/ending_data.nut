// Generated from data/company-endings.json.
::AfeixExpedition.Endings <- { company = { early_loss = { title = "还没走远的黑旗", text = "出发时，大家争过旗应该挂多高，锅该放哪辆车，第一笔钱先买粮还是补甲。那些争论还没来得及变成营地的老笑话，最后一场仗就到了。\n\n风从折断的旗杆旁吹过去。没有人替这次失败编出一个秘密的胜利，名册上已经写下的名字，却也不该被一句‘又一支佣兵团’盖住。有人曾经认真等过他们回来。" }, last_watch = { title = "最后一次点名", text = "战场安静下来时，黑旗还挂在半截旗杆上。最后一道命令已经无人接续，营地里预备的下一顿饭，也等不到原来的那一桌人。\n\n后来有人拾到那本翻卷的名册：有人字写得大，有人只在边角留了一个记号；欠账、轮值和笑话挤在一起。远征团停在了这里。那些真正同过路的人，曾经比雇主账上的一行价钱复杂得多。" }, fallen_legend = { title = "名声没能挡住最后一刀", text = "消息传回城镇时，酒馆里有人说不可能：这面黑旗明明走过更难的路，明明还有许多旧账没结、许多约定没赴。可经验不会替人挡刀，过去的胜利也不能把最后一场战斗重来。\n\n说书人很快替他们添上了整齐的豪言。真正留下来的账页却记着修坏过的盾、分错过的粮，还有被划掉又重新写正的名字。名声可以继续走，远征团的脚步停了。" }, legacy = { title = "旗收起来，路留下来", text = "最后一份契约交回去时，雇主又递来一张价钱很好的新纸。这一次，你把它推回桌面。黑旗已经走过不止一场席卷各地的灾难，也攒下足够响亮的名字；再多一张契约，不会替任何人长出第二段人生。\n\n散伙饭摆得很长。有人谈住处，有人又想上路，有人只想睡到不必轮岗的早晨。名册没有烧，旧旗也没卖。后来年轻佣兵问起秘诀，你翻出最早那页歪歪斜斜的开销：先算清怎么回来，再谈要去多远。" }, after_crisis = { title = "风暴过去以后", text = "大战的消息终于不再每天追着粮车跑。黑旗带回了一场危机结束的见证，也带回许多在捷报上找不到位置的疲惫。你趁下一张征召令还没贴出来，宣布这一次要真正歇下。\n\n没有所有人同时举杯的漂亮画面。有人忙着缝行李，有人去找旧相识，还有人坐在熄火的锅边，隔了很久才相信明天不用再出阵。远征团挣来的这段安稳，就从这样一个平常的清晨开始。" }, renowned = { title = "招牌留在酒馆里", text = "如今报出黑旗的名字，酒馆老板会先挪出一张桌子。你却把招募告示从门边揭了下来。名声已经够响，剩下的日子不必全交给雇主挑选。\n\n最后一晚，众人轮流纠正彼此讲错的战绩，谁救过谁、谁走过冤枉路，吵得比平日还热闹。账结完，分到手的去处各不相同。门上的旧钉眼还在，往后来往的旅人偶尔会指着它，问这里是不是曾挂过一面黑旗。" }, ordinary = { title = "把这一程走完", text = "远征团没有成为每个城镇都知道的传奇。它接过一些活，吃过一些亏，终于在一个没有催债人敲门、也没有新战鼓响起的日子收了旗。\n\n你把剩余的物资一件件点清，让每个人知道自己能带走什么。没有许诺的庄园，也没有最后一仗就能翻倍的诱饵。同行是一程，分别也该说清。清晨有人先走，有人多坐了一会儿，旧营地最后只剩压平的草和一圈冷灰。" }, humble = { title = "趁还能回头", text = "黑旗还不值几个钱，修装备的账倒每一笔都很实在。你看着下一份契约，终于承认队伍不该只靠‘再接一单就好了’往前推。\n\n散伙没有排场。能分的分开，能退的退回，各人的行李重新绑紧。失望当然有，抱怨也不轻；至少告别发生在众人还可以亲口说话的时候。远征团没有走到当初吹嘘的远方，这个决定却让余下的路仍然归各人自己。" } }, callbacks = { afei_dead = "阿飞的名字没有从第一页抹掉。那张曾把‘嘉豪’写得很大的招募纸夹在后面，折痕正好穿过金穗的草图。记下这行的人各有自己的后路，没有再假装能等来他的一声集合。", afei_absent = "最初挂旗的阿飞已不在当前队伍里。收尾的人照着现有名册点完物资，没有借他的名义替所有人作最后一个决定。", jiahao = "阿飞最后仍想把收旗仪式办得体面，连站位都摆了两遍。等有人催着赶车，他把自己那段话缩成一句‘路上当心’，让出了最显眼的位置。嘉豪的排场留着，什么时候该让人走，他已经学会。", toad = "拆营时，阿飞下意识先伸手去扛最重的那捆东西，扛起来又哇哇叫着让人搭把手。曾经靠别人护着才站稳的人，如今终于知道，能顶在前面，也可以大大方方叫同伴一起用力。", feidie = "关于飞碟的传闻越传越夸张，阿飞听了还要争辩几句。可那几段由伙伴亲手补上的经历，名册里都写着各自的名字。他没有把别人的一程功劳，改成自己一个人的神迹。", roots = "六根的记录一页页留在名册里。已经完成的约定有落款，尚空着的位置也没有替谁补字；收旗不会让没走完的路忽然变成圆满。", bottle_kept = "小酒瓶当初选择继续同行，那次谈话被好好留在记忆里。如今远征团收旗，曾经留下的决定也不等于一辈子的欠条；她往哪里去，仍由她自己开口。", bottle_departed = "小酒瓶早已离队，去奔自己的下一场机会。最后整理行装时，没有人把她的空位写作阵亡。曾经同路和后来分别，都真实地占着名册的一行。", bicycle_kept = "那辆旧自行车仍在。它没有被当作传奇宝物抬起来，只是有人擦掉车座上的灰，试了试链条，把它靠回能随手推走的地方。留下回忆，也可以继续过日子。", bicycle_released = "旧自行车已经被送下山坡，行李里再也找不到它。那次放手没有抹掉曾经扶过的一程；后来想起时，记得的终于不只剩离开的背影，还有自己学会接稳的那一下。", bicycle_unfinished = "自行车那一页停在尚未作答的地方。战役结束没有替当时的人选下去，留下与放手，都仍是没有落笔的可能。" }, members = { afei = { good = "阿飞在酒馆门口支起小桌，替新来的佣兵看契约。遇见离谱价钱，他照样叫得半条街都听见；只是如今有人肯坐下来，等他把撤退的路讲完。", lean = "阿飞把招募牌翻过来当了桌板，‘嘉豪’两个字仍不肯刮。日子紧时他也接短工，偶尔吹起将来，却终于肯先问这一顿大家能不能吃饱。", memorial = "名册旁留着阿飞还没说完的“一起回来”。披风叠好了，旗上的嘉豪却仍写得张扬。伙伴说起他，先笑那声哇哇叫，笑到后来，又想起他认真推回契约时的脸。" }, damou = { good = "王大谋开的小练武场从来不缺来切磋的人。他仍见高手就喊大哥，却把第一排留给新手；有人终于跑来问他借一招，他笑着递出了木盾。", lean = "王大谋带着磨旧的盾去做短程护卫，收工还在空地教人站稳。借来的招数不少，他肯留下来陪别人练的时间，最后成了最实在的报酬。", memorial = "王大谋的旧盾系住了裂口，仍放在名册旁。练过他教的那一步的人，收盾时总会再看一眼。桌边有人习惯地喊了声大哥，空下的凳子却迟迟无人接话。" }, mocha = { good = "午夜抹抹茶收了最后一叠收据，开起替商队核账的小铺。有人想用豪言抵尾款，他把算盘推过去：故事可以慢慢讲，欠伙计的钱今天先结。", lean = "午夜抹抹茶把余款算了三遍，连最小一笔也写明白，随后去商行做账。新东家第一次想省伙计的伙食，他便把那一栏重新划到了最上面。", memorial = "算盘收在账本上，最后几笔仍待结清。抹茶将伙食与修补写得靠前，伙伴便照着次序去办。珠子再拨响时，阿飞总下意识等一句冷话，桌边却只剩清点的声音。" }, bottle = { good = "小酒瓶回到自己的球场，催队友把球送过来。有人喊蛤妈，她回头笑骂一句，转身仍去争自己的胜负；陪过别人的成长，没有占掉她的下一场。", lean = "小酒瓶攒起下一程盘缠，找了块空地继续练球。没有漂亮场地也照样要接稳，她给旧伙伴留的话很短：等真有比赛了，再来给瓶队喊两声。", memorial = "小酒瓶的那页名册夹着球场的旧纸，旁边记有她打出的突破，也有下一场的打算。有人叫了声瓶队，才想起这次没人催他传球。旧伙伴把那只球擦净，放回她常用的位置。" }, shuaizi = { good = "白小帅子接了镇门庆典的鼓，头一声响起时自己仍会一抖。人群一乱，她却能稳稳敲够四下；旧队友从门口路过，也乖乖等她给信号。", lean = "白小帅子替驿站记夜间出入，鼓面补了又补。她还是怕忽然的响动，轮到有人晚归，却总把灯多留片刻，先数清人数再关门。", memorial = "鼓槌绑在一起，末端握得发亮。伙伴记得她害怕时一遍遍说慢一点，也记得门口那四声鼓。后来集合总有人数到第四下，才将脚步迈出去。" }, lili = { good = "李李超欧把高背椅带回巡演场，灯一亮就要争最好的位置。有人等着看欧气，她干脆多加一轮箭靶：名号可以喊，输赢还得亲手打。", lean = "李李超欧的巡演从一张小凳子重新开始，她仍叫自己超巨。没钱添灯就赶在天黑前射完，收场时总多练最后一箭，不让名号替自己找借口。", memorial = "李李的箭袋卷好，椅背上醒目的记号还在。旧靶纸留下几次偏箭，也留下后来改准的那一处。伙伴把高背椅放到灯旁，说起超巨，仍能记得她那副等人喝彩的神情。" }, xiaoyueya = { good = "小月牙终于有了一间真的杂货铺，招牌大得几乎挡住窗。旧零件仍摆满半面墙，新伙计第一条规矩是：动手试之前，先说清这次会不会炸锅。", lean = "小月牙推着杂货车走集市，把拆营剩下的小扣子也分门别类。生意不大，她仍能给卖不出去的东西找到第二种用途，连旧招牌都换了两次名字。", memorial = "零件袋上贴满“还能用”的小纸条，几样东西却再没人说得清该怎样装。收拾的人把它们一一扎好，连歪招牌也留着。手里拿起一颗旧扣子时，总觉得身后会喊一声先别扔。" }, yuchujiu = { good = "余初九带起短途护送队，第一条规矩就是回来先点人。她照旧把提醒喊得像吵架，新团长才摆出威风，便被她追问队尾究竟谁照看。", lean = "余初九去商队做巡哨，拿到的第一张名单先数了两遍。收工前有人催她领钱，她摆摆手，等最后一辆车露头才肯过去。", memorial = "初九的名单边上，重数的记号一笔接一笔。伙伴照旧先点人，再报战果，念到她的名字，才发现那声最响的应答再也等不来。名单于是又数了一遍。" }, xiaoyubeike = { good = "小鱼贝壳又去了忙碌的栈桥，肯顶上去的人很快都认得她。她偶尔还拿‘大哥’开玩笑，却会在累时明确叫替班，不再把硬撑当成唯一的担当。", lean = "小鱼贝壳接了码头的护卫活，工钱按时辰算。她照旧先把挤乱的路口顶住，到了交班点也照旧开口要人接手，没把力气白白借到明天。", memorial = "小鱼的盾沿留着重压下的凹痕，握带仍系得结实。“我先上”那句话，许多人都听过。后来轮换举盾，伙伴会在交班前主动伸手，像那只曾递到她身边的手一样。" }, wangduidui = { good = "王怼怼收下镇上调度口信的活，把三个问题挂在门边。有人拿太子的名号奉承她，她先问对方谁来接应，直到一句空话也塞不进回执。", lean = "王怼怼替商行跑口信，报酬不多，问题一个不少。有人嫌她太爱怼，她把牌子翻到背面：去哪里、做什么、谁接应，问完才肯出门。", memorial = "令牌背面的三个问题仍刻得清楚，歪王冠挂在旁边。伙伴将安排逐项读过，读完才想起，这一次怼怼没再追问一句。出发前，他们又核对了一遍接应的人。" }, laocai = { good = "老蔡在商路旁做起护队参谋，地图上的木旗依旧不摆满。雇主问空着的一格有什么用，他先让对方说清，计划失手时准备让谁回来接人。", lean = "老蔡给来往货队画简易路线，纸张省着用，退路从不省。别人愿意付的钱有限，他就把能保证的范围说得更短，不再替谁承诺整片地图。", memorial = "地图留着空角，木旗收在布袋里，背面的名字还能认出。桥梁那截木块也被留了下来。后来有人铺图谈路，伙伴总会先将队尾摆上，再替接应留一个位置。" }, yanzi = { good = "眼子带着剑盾和最后一份交接清单离开黑旗。商路上的熟人仍爱找他帮忙，他却开始先问清事情，再决定是否接下。笑话照讲，酬劳与时辰也照样认真谈；至于下一处落脚地，他说这回想自己慢慢挑。", lean = "眼子仍替商队转交口信，偶尔坐在路边给人核账。钱袋不算宽裕，他先把说定的事做完，再接下一份。碰见黑旗旧人，他总能接上一句玩笑，随后认真问对方这次究竟想托他办什么。", memorial = "营火旁少了眼子接话的声音，未写完的交接纸夹在账本里。伙伴把亲眼见过的那段补上，各自签了名。有人想起他的笑话，讲到一半停住，最后又将桌边的空凳摆正。" }, tiantong = { good = "小虎接管一段驿路，蓝旗信袋在柜边挂得笔直。小虎的名声传开以后，她仍亲自核对签收的人，不肯把‘到过镇子’写成信已经送到。", lean = "小虎继续背信袋跑短路，修补的线用了两种颜色。急件催得再响，她也先问交给谁，回来时才把回执一张张展开晾平。", memorial = "蓝旗信袋里，已签与未签的回执分得清楚。送完的归档，未到的退回，伙伴按小虎留下的标记逐封核对。最后扣好袋口时，又像她从前那样多查了一遍。" }, xiaoning = { good = "小宁的新地图终于添上图例，外人能认出一半，另一半还得请她本人讲。每到说得入神时，她仍忘了擦嘴角，直到有人递来一块手帕。", lean = "小宁靠画附近小路挣饭钱，奇怪的符号照画不误。她学会在漏掉的转角旁添一句说明，偶尔真帮赶路的人省下半天绕行。", memorial = "小宁的地图少了一角，后来补的指路话却还看得清。伙伴照着图例认出河，又为那个面饼似的记号笑了笑。图折起来，旁边那块替她擦过嘴角的手帕也一并收好。" }, xiaopangxu = { good = "小胖在街口教人卡拍，给初学者留出摔跤的空地。提起嘉豪步伐，她还是不服，遇见旧队友就要比一轮，第四拍却终于能等对方跟上。", lean = "小胖白天做工，傍晚在空桶旁练舞。没有整支队伍给她打拍子，她也把重心一遍遍找回来，偶尔路过的孩子先学会了那声数拍。", memorial = "旧靴底留着练舞磨出的痕迹，深浅恰好像几道节拍。有人在营火旁数到第四声，脚却不知该往哪放。空地仍留着，倒下的桶被轻轻扶回角落。" }, dae = { good = "大鹅看起驿站的院子，空凳子上照样一顶帽子占一个位置。她的嗓门让过客绕远，也让晚归的人放心：门里还有一块地方记着自己。", lean = "大鹅在集市帮人看摊，先把自家人的位置圈清楚。遇见争抢仍要喊得很响，可叫同伴回来吃饭时，那一声也从来不比冲锋轻。", memorial = "占座的帽子放在最后一张空凳上。往日大鹅总先喊这里有人，收营时，伙伴便也替她留到最后。待人都点齐，帽子才被认真收进行囊。" }, manyuemei = { good = "蔓越莓办的演练场规矩简短，红线落在哪里，人人都得先看清。她仍不喜欢重复解释，但有人指出疏漏时，她会当着众人的面重新拉线。", lean = "蔓越莓替临时护队安排演练，收的钱够买线和弩弦。她不急着把自己说成大师，只让没听明白的人再复述一次，直到位置真的站对。", memorial = "红线剩得不多，接头却缠得整齐，漏摆过的那枚木片也在袋底。伙伴重新排位，先把它放上桌。说完一个问题再说下一个，那几句短话，仍有人记得。" }, xiaohani = { good = "罗一可把分得的酬劳装进一个新布袋，这次用不着藏进最深的衣缝。她仍带着几样够用的储备上路，碰见愿意坐下来的人便分几颗栗子。自己的屋檐还没有定下来，但留在哪儿、走向哪儿，终于都能慢慢挑。", lean = "罗一可继续替商队护送，路费和口粮各系一根绳。收入不多，她就一段一段攒，不再把一辈子要用的东西都背在肩上。人们还能认出那个口袋鼓鼓的仓鼠，却很少见她饿着自己把最后一份也递出去。", memorial = "几只布袋系着不同的结，针线、路费和栗子各有自己的位置。伙伴认得她怎样分装，便照样收好。那袋留给自己的栗子仍在，名册旁也记着她曾想攒下的一扇窗。" }, keke = { good = "可可在旅人落脚处开起小店，进门的人得先报个名字。她仍愿意替自己人腾位置，也开始理直气壮地叫人轮流帮忙，不再一个人收拾所有残局。", lean = "可可回到熟悉的落脚处做事，桌椅少，来往的人却总能认清。忙不过来时她会开口叫帮手，‘自己人’终于也包括可以被别人照顾的她。", memorial = "可可认过名字的小纸片夹在名册里，有几张沾得看不清。大家一同搬桌、收凳，手忙的时候总想再喊她一声。最后先把她自己的名字写好，才添上那些曾受她照应的人。" }, yuxiang = { good = "余想带出的守卫队有一张写得极清楚的轮值表。五老压阵的名声让雇主安心，她自己更满意的一点是：每次交班，确实有人按时站到面前。", lean = "余想继续做长枪护卫，签约时先问替班。她不靠一个响亮称呼多讨钱，也不肯再让别人把‘你最稳’当成无穷无尽加时辰的理由。", memorial = "轮值表在余想最后那一班划了线，来接岗的人认真写下时辰。长矛收回架上，钥匙交到下一只手里。那句她问过许多次的谁替班，伙伴这回亲口答完了。" }, tongzhu = { good = "童猪的小熊游戏成了集市常见节目，越不服气的人越爱围过来。有人认出她跟过黑旗，想讨一次重来，她把木熊推过去：规矩写着呢。", lean = "童猪带着木熊走小集，赢来的钱刚够下一顿。她仍把规则先念清，偶尔让吹牛的客人当场出糗，收摊时也照规矩结清自己输掉的那份。", memorial = "木熊底下的规矩摸得光亮，桌边还记着旧队长输掉的那局。有人照规则摆了一遍，笑出声，又将杯子轻轻放下。再开局时，大家先等那声约好的敲杯。" }, meiya = { good = "美伢领起新的巡演队，大王舞照样热闹。到了谢幕，她会把忙了一晚的伴舞拉到前面，自己稍退半步，看所有人都找到该站的位置。", lean = "美伢接着跑小场演出，先检查哪块木板会绊脚。场地再窄，她也给同伴留出转身的空隙，等掌声落下才把布景一同收走。", memorial = "美伢的舞带折在行李上，鼓手记得她纠正过的半拍。收场的人将过道的椅子搬开，给忙了一晚的伙伴留出位置。说起大王舞，仍有人会跟着试一遍她教的步子。" }, wanshe = { good = "玩蛇的练武场门前挂着很大的名号，场里却只有朴素木桩。来看秦国的神的人，往往先被她拉着纠正脚步，站稳以后才许问下一招。", lean = "玩蛇四处试招，收不起徒弟就找人互练。招式的名字仍起得夸张，木桩上的痕迹却一天比一天实在，她愿意为半寸落脚争到天黑。", memorial = "练习木桩收在破装备旁，蛇形痕迹有深有浅，旧脚印也还在。大谋摸着那处反复试过的地方，想起没争完的半寸落脚。到了天黑，木剑仍靠在原处。" }, tutu = { good = "涂涂在最后一顿饭后唱完自己想唱的曲子，第二天按约出发。往后她偶尔寄来下一站的消息，回来也是自己愿意，离开不再被算作辜负。", lean = "涂涂背着行李继续找能唱歌的地方，路费紧时多留一晚。她仍认真说什么时候告别，也仍保有在另一堆营火旁重新坐下的自由。", memorial = "涂涂留下的曲子夹着一张下一站的路票，歌词里还有曾谈过的去处。伙伴唱到那一段，便想起她坐在火边拿回手套的夜晚。歌唱完，纸页被平平整整地收好。" }, naigai = { good = "奶盖在练武场边说起取胜办法还是滔滔不绝，不过说完就得自己拿盾上场。熟客专等她挨第一下后的解释，也等她笑着把盾重新举起来。", lean = "奶盖找了一份看货的活，空时仍在旁边论武。吹大了就会被人拉去比一轮，她输得嘴硬，却没有再把自己的盾悄悄留给别人拿。", memorial = "奶盖的盾修过不止一次，握带上还留着新打的结。伙伴笑起她吹过的牛，也记得下一轮叫她时，盾总会重新举起来。旧战报夹在盾后，最夸张的那句，仍画着她自己添的圈。" }, xiaojie = { good = "小杰管起商队的车库，备用钥匙都有单独的交接记录。老朋友想凭一句认识就把车推出去，也得先签名；等他们回来，她才放心把锁扣好。", lean = "小杰靠修锁看车攒钱，工具一件件添。遇到催促就把交接单拿出来，她知道少信一句没凭据的保证，常常能让别人少丢一整车东西。", memorial = "备用钥匙一把把绑着小牌，借还记录也保存得齐整。伙伴照她写的名字交还工具，最后听见锁扣落下。熟人想催两句，看到那本交接单，还是先将自己的名字签好。" }, bula = { good = "bula把钱袋戏法搬回小舞台，观众看得惊叫，她散场照旧逐枚点钱。如今能给帮手开足报酬，才是她最愿意展示的一次钱袋变厚。", lean = "bula在集市表演小戏法，收入不稳就缩小开销。她不承诺把空袋变成下一支大军，分给一起做事的人的那一份，却总当面数清。", memorial = "钱袋和账目一并留下，属于同伴的份额照记录逐项归还。桌角那枚戏法铜片还很薄，摸起来却让人想起台上的惊叫。清点的人将它另收一袋，留作那次掌声的纪念。" }, suwa = { good = "苏袜替商队领路，跑到岔口会先停半步，让后面的人看清路标。她仍走得快，只是现在回头时，总能等到一整支队伍跟上。", lean = "苏袜跑起附近的送货路，转弯前把记号做得大一点。抢来的半步不再全花在自己身上，等人看明白再走，反倒少了许多回头寻找。", memorial = "苏袜留下的岔口记号急却清楚，步行和车行各有一条线。伙伴照着走过，回头仍能看见后来的人跟上。那个总想快半步的人，替大家留在路上的标记却一直等着。" }, qianhan = { good = "千涵在短坡上带人练跑，003的号码缝回旧衣。有人又把她说成传奇，她边纠正边示范呼吸：先跑好这一段，再谈你还没到的终点。", lean = "千涵靠跑腿做工，休息时仍分段练呼吸。003号没有变成响亮头衔，她也不着急，每一段跑完便记一次，认真得让同行的人不好意思偷懒。", memorial = "003号被平整缝在布页上，练习簿旁边记着她跑完的短段。空格还有几处，填过的也都看得清。伙伴用那根标距绳重新量过坡道，将起点留在她曾站过的地方。" }, wangdazhi = { good = "王大芷搭起新演出的幕布，也把自己的名字写进节目单。谢幕时她走到台前，等掌声真正落到自己身上，才回头招呼还在忙碌的同伴。", lean = "王大芷替小剧班支场子，收入不多，节目单上却总留着芷芷的位置。她会把幕布撑稳，也会开口提醒：这一段，轮到我上场了。", memorial = "节目纸展开，王大芷的名字就在她自己改过的位置，旁边仍写着芷芷。伙伴提起她救场的本事，也提起她终于走到幕布前的那一回。收好纸以前，有人又把那行轻轻读了一遍。" }, yaoyaoya = { good = "瑶瑶牙在比武场上仍出手干脆，奶团吕布的叫好声一响，她先瞥一眼同伴的旗。赢了这一场之后还有人一起回去，比多追一步更值得得意。", lean = "瑶瑶牙拿短程护卫活维持练武，名头照叫，步子却收得住。有人激她单独追出去，她回头确认队伍还在，才决定这一刀究竟该不该出。", memorial = "确认位置的小旗收进布套，长柄兵器靠在旁边。伙伴记得她打出的缺口，也记得出手后回看这一面旗的动作。旧挑战书压在护送安排下面，次序仍和她放下时一样。" }, yangmiemie = { good = "羊咩咩做起熟路上的送货生意，铃铛过弯前先响。客人夸她送得快，她先打开包裹给人看：东西完整到了，这趟才算真正跑完。", lean = "羊咩咩推着小车接零散包裹，遇到长坡就提前留力。铃铛不是什么英雄信号，却让路边的人知道，有一份被好好护着的东西快送到了。", memorial = "小铃放在车把旁，待送包裹的封口重新查过。伙伴接着送完剩下的路，在回执上签了自己的名字。回来收车时，铃轻轻响了一声，像她过弯前的提醒。" }, songnuanyang = { good = "宋暖阳把旅途笔记整理成薄册，胜仗与败仗都留在里面。读者嫌末页不够漂亮，她缩了缩鹌鹑纹兜帽，仍把那个没回答完的问题印了出来。", lean = "宋暖阳替旅人写信，空闲才抄自己的笔记。纸不够时她缩小字，却不把失败那几天撕掉；有人问起黑旗，她先讲自己确实见过的。", memorial = "暖阳最后一页停在半句话，页边那只小鹌鹑也只画完一半。伙伴读过胜仗和败仗，将自己知道的事另写在后页。翻回她的字迹时，那个还没问完的问题仍留在那里。" }, xiaogui = { good = "溺水小龟把自己的战绩牌挂得端端正正，逢人便要讲是哪一场。夸起飞爹当然还很响，讲到关键一下，却终于能用自己的名字把故事说完。", lean = "溺水小龟背着壳接短途活，亮粉蝴蝶结仍收拾得很精神。战绩牌没有传说里夸张，她照样一条条记，等下次碰见熟人便拿给对方看。", memorial = "小龟的战绩牌收在名册旁，亮粉蝴蝶结也系得整齐。牌上是她自己的名字，一场场胜负都有记录。阿飞坐了很久，将她亲手画过的下一步摊开，又看了一遍。" } } };
