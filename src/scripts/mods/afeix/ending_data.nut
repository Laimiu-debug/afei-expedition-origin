// Generated from data/company-endings.json.
::AfeixExpedition.Endings <- { company = { early_loss = { title = "还没走远的黑旗", text = "黑旗出发还没多久。旗该挂多高、锅放哪辆车、第一笔钱先买粮还是先补甲，这些事他们还没吵完，最后一仗就来了。\n\n风从断掉的旗杆边吹过。没人替这场败仗编出什么暗中的胜利，可名册上那几个名字，也不该被一句“又一支佣兵团”就打发了。镇上有人等过他们回来。" }, last_watch = { title = "最后一次点名", text = "仗打完了，黑旗还挂在半截旗杆上。最后那道命令没人接，营里给下一顿备的饭，也等不来原来那一桌人。\n\n后来有人捡到那本卷了边的名册。有人字写得老大，有人只在角上画了个记号，欠账、轮值和笑话挤在一页上。远征团就停在了这儿。" }, fallen_legend = { title = "名声没能挡住最后一刀", text = "消息传回城里，酒馆里有人拍桌子说不可能：这面黑旗走过比这难得多的路，还有一堆旧账没结、一堆约没赴。可名气挡不了刀，赢过的仗也不能拿来把最后一场重打一遍。\n\n说书人很快给他们编好了一套豪言壮语。真留下来的那几页账，记的却是修坏过的盾、分错过的粮，还有几个划掉又重新写上的名字。" }, legacy = { title = "旗收起来，路留下来", text = "最后一份契约交回去的时候，雇主又递来一张价钱很漂亮的新单子。这回你把它推了回去。黑旗扛过不止一场席卷大陆的灾祸，名号也够响了，多接一单，谁也不会因此多活一辈子。\n\n散伙饭摆了老长一溜。有人在谈住处，有人还想接着走，有人只想睡一个不用轮岗的早上。名册没烧，旧旗也没卖。后来有年轻佣兵来问有什么诀窍，你翻出最早那页歪歪扭扭的开销账：先算清怎么回来，再谈走多远。" }, after_crisis = { title = "风暴过去以后", text = "打仗的消息总算不再天天追着粮车跑了。黑旗亲眼看着一场大祸收了尾，也带回一身捷报上写不下的疲惫。你趁着下一张征召令还没贴出来，宣布这回是真的歇了。\n\n没人举杯，也没人讲话。有人在缝行李，有人去找旧相识，有人坐在熄了火的锅边，过了好久才信明天真不用再上阵。" }, renowned = { title = "招牌留在酒馆里", text = "如今一报黑旗的名号，酒馆老板就先腾出一张桌子来。你却把门边的招募告示揭了下来。名气够响了，剩下的日子用不着全交给雇主去挑。\n\n最后一晚，大家轮流揭穿彼此吹过头的战绩，谁救过谁、谁带错过路，吵得比哪天都热闹。账结完，各人去了各人的地方。门板上那个旧钉眼一直留着，后来路过的旅人偶尔会指着它问：这儿以前是不是挂过一面黑旗？" }, ordinary = { title = "把这一程走完", text = "远征团没能成为家喻户晓的传奇。接过些活，吃过些亏，最后在一个没有债主敲门、也没有战鼓响起的日子里收了旗。\n\n你把剩下的物资一件件点清，让每个人知道自己能拿走什么。没许谁庄园，也没拿“再打最后一仗就翻倍”去哄人。第二天一早，有人先走了，有人多坐了一会儿。旧营地最后只剩下压平的草和一圈冷灰。" }, humble = { title = "趁还能回头", text = "黑旗还不值几个钱，修装备的账倒是一笔比一笔实在。你看着下一份契约，终于承认这支队伍不能光靠“再接一单就好了”撑下去。\n\n散伙没什么排场。能分的分了，能退的退了，各人把行李重新捆紧。失望是有的，骂声也不小，好在告别的时候，大家都还能亲口说上一句话。" } }, callbacks = { afei_dead = "阿飞的名字还在名册第一页。那张把“嘉豪”写得老大的招募纸夹在后头，折痕正好压过金穗的草图。没人再假装能等到他喊一声集合。", afei_absent = "最早挂旗的阿飞已经不在队里了。收尾的人照着现有的名册点完物资，没有拿他的名义替大家拍最后一次板。", jiahao = "阿飞还是想把收旗办得体面些，站位摆了两遍。等有人催着赶车，他把准备好的一大段话缩成一句“路上当心”，自己让出了最显眼的那个位置。", toad = "拆营的时候，阿飞下意识先去扛最重的那捆东西，刚扛起来就哇哇叫着喊人搭把手。几个人笑着围上来，一起把那捆东西抬上了车。", feidie = "关于飞碟的传闻越传越邪乎，阿飞听了还要较真争几句。不过名册里那几段是哪几个人陪他一起走出来的，名字都写得清清楚楚，他一个也没划掉。", roots = "六根的记录一页页留在名册里。办完的有落款，没办完的那几格就空着，没人替谁补上字。", bottle_kept = "小酒瓶当初选了留下。如今远征团收旗，她要往哪儿去，照旧是她自己说了算。临走前，她又把那只旧球往阿飞脚下拨了一下。", bottle_departed = "小酒瓶早就离队，奔她自己的下一场去了。最后收拾行装时，没人把她那一格写成阵亡。一起走过的那一段，名册里照样记着。", bicycle_kept = "那辆旧自行车还在。没人把它当宝贝供起来，只是有人擦掉车座上的灰，试了试链条，把它靠回随手就能推走的地方。", bicycle_released = "旧自行车早就顺着山坡滑下去了，行李里再也找不着它。阿飞后来想起那一程，记得的不光是她走时的背影，还有自己头一回把球接稳的那一下。", bicycle_unfinished = "自行车那一页停在还没作答的地方。仗打完了，那道题也就一直空在那儿。" }, members = { afei = { good = "阿飞在酒馆门口支了张小桌，帮新来的佣兵看契约。碰上离谱的价钱，他照样嚷得半条街都听得见。不同的是，如今真有人肯坐下来，等他把撤退的路讲完。", lean = "阿飞把招募牌翻过来当了桌板，上面“嘉豪”两个字死活不肯刮掉。日子紧了他也打短工，偶尔吹两句将来，可开口前总先问一句：今天大家吃饱了没有。", memorial = "名册边上，阿飞那句“一起回来”还没写完。披风叠好了，旗上的“嘉豪”照样张扬。兄弟们说起他，先笑他那一嗓子哇哇叫，笑着笑着，又想起他把那份契约推回去时的那张脸。" }, damou = { good = "王大谋开了个小练武场，来切磋的人就没断过。他还是见了高手就喊大哥，只是第一排总留给新手。后来真有人跑来找他借一招，他笑着把木盾递了过去。", lean = "王大谋扛着那面磨旧的盾接短途护卫，收了工还在空地上教人站桩。他借来的招数不少，可最让人记得的，是他肯陪人练到天黑。", memorial = "王大谋的旧盾用绳子捆住了裂口，就靠在名册边上。跟他学过收盾的人，收盾时总忍不住往那边瞅一眼。有回吃饭，有人顺嘴喊了声“大哥”，半天没人应。" }, mocha = { good = "午夜抹抹茶揣着最后一叠收据，开了间替商队查账的小铺。有人想拿几句豪言抵尾款，他把算盘往前一推：故事慢慢讲，欠伙计的钱今天先结。", lean = "午夜抹抹茶把散伙的钱算了三遍，连最小一笔都写明白了，然后去商行做了账房。新东家头一回想克扣伙计的伙食，他二话不说，把那一栏挪到了账本最上头。", memorial = "算盘压在账本上，最后几笔还没结。抹茶总把伙食和修补写在最前头，兄弟们就照着这个次序去办。算盘珠子再响的时候，阿飞总下意识等他那句损人的话，桌边却只剩下点数的声音。" }, bottle = { good = "小酒瓶回了自己的球场，一上场就催队友把球传过来。有人喊她蛤妈，她回头笑骂一句，转身照样去抢自己的球。", lean = "小酒瓶攒着下一程的路费，找了块空地接着练球。场地不像样，球照样得接稳。给老伙计留的话就一句：真有比赛了，记得来给瓶队喊两嗓子。", memorial = "小酒瓶那页名册里夹着一张旧球场的纸，上面记着她那几回突破。有人喊了一声“瓶队”，才想起这回没人催他传球了。老伙计把那只球擦干净，放回了她常放的地方。" }, shuaizi = { good = "白小帅子揽下了镇门庆典的鼓，头一声响起来她自己还是会抖一下。可人群一乱，她照样稳稳敲足四下；老队友从门口路过，也乖乖站住等她的信号。", lean = "白小帅子在驿站管夜里的进出，鼓面补了又补。她还是怕突然的响动，可谁要是晚归，她总会把灯多留一会儿，数清了人才关门。", memorial = "她那对鼓槌被绑在了一起，握的那头磨得发亮。兄弟们记得她害怕时一遍遍说“慢一点”，也记得门口那四声鼓。后来集合，总有人在心里数到第四下，才肯迈步。" }, lili = { good = "李李超欧把高背椅带回了巡演场，灯一亮就要抢最好的位置。有人等着看她的欧气，她干脆多摆一轮箭靶：名号随你喊，输赢还得亲手射出来。", lean = "李李超欧的巡演从一张小板凳重新开张，她照样自称超巨。没钱添灯，就赶在天黑前射完；收场前总要再多射一箭，不让名号替自己找借口。来这儿，开心就好。", memorial = "李李的箭袋卷好了，椅背上那个显眼的记号还在。旧靶纸上留着几回偏箭，也留着后来校准的那一处。兄弟们把高背椅挪到灯边，说起超巨，还能想起她那副等人喝彩的神气。" }, xiaoyueya = { good = "小月牙总算有了间真正的杂货铺，招牌大得差点把窗户挡住。半面墙摆的都是旧零件，新伙计学的第一条规矩是：动手试之前，先说清楚这回会不会炸锅。", lean = "小月牙推着杂货车跑集市，连拆营剩下的小扣子都分门别类。生意不大，可卖不出去的东西，她总能给找出第二种用处，旧招牌都换了两回名字。", memorial = "零件袋上贴满了写着“还能用”的小纸条，有几样却再没人说得清该怎么装。收拾的人把它们一样样捆好，连那块歪招牌也留着。拿起一颗旧扣子的时候，总觉得身后会有人喊一声“先别扔”。" }, yuchujiu = { good = "余初九带起了一支短途护送队，头一条规矩就是回来先点人。她喊提醒照样跟吵架似的，新来的头领刚摆出威风，就被她追着问队尾到底谁在看着。", lean = "余初九在商队里当了巡哨，拿到的第一张名单先数了两遍。收工时有人催她去领钱，她摆摆手，非等最后一辆车露了头才肯过去。", memorial = "初九那张名单边上，重数的记号一笔挨着一笔。兄弟们照旧先点人、再报战果，念到她的名字时，才发现那一声最响的“到”再也等不来了。名单于是又数了一遍。" }, xiaoyubeike = { good = "小鱼贝壳又回了那座忙乱的栈桥，敢顶上去的人很快都认得她。她偶尔还拿“唯一的男人”开玩笑，只是累了会直接喊人替班，不再死扛。", lean = "小鱼贝壳在码头接了护卫的活，工钱按时辰算。挤乱的路口她照样先顶住，到了交班点也照样开口喊人来接，一点力气都不往明天借。", memorial = "小鱼的盾沿上留着被重击压出来的凹坑，握带还系得结结实实。“我先上”这句话，好多人都听她说过。后来轮班举盾，兄弟们总会在交班前先把手伸过去。" }, wangduidui = { good = "王怼怼在镇上揽了传令调度的活，把那三个问题挂在门边。有人拿太子的名号奉承她，她先问对方谁去接应，问到一句空话都塞不进回执为止。", lean = "王怼怼替商行跑腿送口信，钱不多，问题一个不少。有人嫌她太爱怼人，她把牌子翻到背面：去哪儿、干什么、谁接应，问完了才出门。倒霉是倒霉了点，口信倒是一封没送错过。", memorial = "令牌背面那三个问题还刻得清清楚楚，歪王冠挂在一旁。兄弟们把安排一条条念完，才想起这回没人再追问一句了。出发前，他们又把接应的人核了一遍。" }, laocai = { good = "老蔡在商路边当起了护队的参谋，地图上的木旗照旧从不摆满。雇主问那空着的一格有什么用，他先让对方说清楚：计划砸了，打算让谁回来接人。", lean = "老蔡给过路的货队画简易路线图，纸省着用，退路从来不省。人家给的钱有限，他就把能保证的那段说得短一些，再也不替谁包下整张地图。", memorial = "地图留着空角，木旗收在布袋里，背面的名字还认得出。那截代表桥的木块也留下了。后来谁再铺开地图谈路，兄弟们总会先把队尾摆上，再给接应留一个位置。" }, yanzi = { good = "眼子带着剑盾和最后一张交接单离开了黑旗。商路上的熟人照旧爱找他帮忙，他现在会先问清楚是什么事，再决定接不接。笑话照讲，酬劳和时辰也照样认真谈。他说下一处落脚的地方，这回想自己慢慢挑。", lean = "眼子还在替商队转交口信，闲了就坐在路边帮人对账。钱袋不算鼓，他总是先把说好的事办完，再接下一件。碰上黑旗的旧人，他张口就能接上一句玩笑，然后认真问一句：这回到底想托我办什么？", memorial = "营火边少了眼子插科打诨的声音，那张没写完的交接单夹在账本里。兄弟们把自己亲眼见过的那一段补上，各自签了名。有人想起他讲过的笑话，讲到一半停住了，起身把桌边那张空凳摆正。" }, tiantong = { good = "小虎接管了一段驿路，蓝旗信袋在柜台边挂得笔直。名气传开以后，她还是亲自核对签收的人，不肯把“到过镇上”写成“信已送到”。点心照旧锁在柜子里。", lean = "小虎还是背着信袋跑短途，补信袋的线用了两种颜色。急件催得再凶，她也要先问交给谁，回来再把回执一张张摊开晾平。", memorial = "蓝旗信袋里，签了的和没签的回执分得清清楚楚。送到的归档，没送到的退回，兄弟们照着小虎留下的记号一封封核过。最后扣上袋口时，又像她从前那样多查了一遍。" }, xiaoning = { good = "小宁的新地图总算添了图例，外人能看懂一半，另一半还得请她本人来讲。讲到入神，她照样忘了擦嘴角，直到有人递来一块手帕。", lean = "小宁靠画附近的小路换饭钱，那些怪符号照画不误。她学会了在漏掉的拐角旁边添一句说明，偶尔还真能帮赶路的人省下半天的绕路。", memorial = "小宁的地图缺了一角，后来补上的那几句指路话还看得清。兄弟们照着图例认出了河，又对着那个饼一样的记号笑了一阵。地图折起来的时候，那块给她擦过嘴角的手帕也一起收好了。" }, xiaopangxu = { good = "小胖在街口教人卡拍，专门给初学的人留出摔跤的空地。一提起嘉豪步伐她还是不服，碰见老队友就要比一轮，不过第四拍总算肯等对方跟上了。", lean = "小胖白天做工，傍晚就在空桶边练舞。没人给她打拍子，她也一遍遍把重心找回来。路过的小孩倒先学会了她那声数拍。数到四就够了，再往上数她自己也不太行。", memorial = "旧靴底上磨出了练舞的痕，深深浅浅，正像几道节拍。有人在营火边数到第四声，脚却不知道该往哪儿落。空地还留着，那只倒下的桶被人轻轻扶回了墙角。" }, dae = { good = "大鹅看起了驿站的院子，空凳子上照样一顶帽子占一个座。她那嗓门能把过路的人吓得绕道走，也让晚归的人放心：门里头还有个地方记着自己。", lean = "大鹅在集市上帮人看摊，先把自家人的位置圈得清清楚楚。碰上抢地方的照样喊得震天响，叫同伴回来吃饭的那一嗓子，也从来不比冲锋时小。", memorial = "那顶占座的帽子放在最后一张空凳上。从前大鹅总是先喊“这儿有人”，收营的时候，兄弟们也替她把位置留到了最后。等人都点齐了，才把帽子收进行囊。" }, manyuemei = { good = "蔓越莓开了个演练场，规矩短得很：红线落在哪儿，人人先看清楚。她还是讨厌重复解释，可有人指出她的疏漏时，她会当着所有人的面重新拉线。", lean = "蔓越莓给临时凑起来的护队安排演练，挣的钱刚够买线和弩弦。她不急着把自己吹成大师，只让没听懂的人再复述一遍，直到站对了位置。", memorial = "红线剩得不多了，接头却缠得整整齐齐，那枚漏摆过的木片也还在袋底。兄弟们重新排位，先把它摆上了桌。一个问题说完再说下一个，她那几句短话，还有人记得。" }, xiaohani = { good = "罗一可把分到的酬劳装进一个新布袋，这回不用再藏进最深的衣缝里了。她照旧带着几样够用的口粮上路，碰见肯坐下来的人就分几颗栗子。那间带窗的屋子还没定下来，可留在哪儿、往哪儿走，总算能慢慢挑了。", lean = "罗一可还在给商队当护送，路费和口粮各系一根绳。挣得不多，她就一段一段地攒，不再把一辈子要用的东西全背在肩上。人们还认得那只口袋鼓鼓的仓鼠，只是很少再见她饿着肚子把最后一口也递出去。", memorial = "几只布袋打着不同的结，针线、路费和栗子各有各的地方。兄弟们认得她是怎么分装的，就照样收好。留给她自己的那袋栗子还在，名册边上也记着她想攒下的那扇窗。" }, keke = { good = "可可在旅人落脚的地方开了间小店，进门先得报个名字。保可梦们常来捧场，她照样替自己人挪位置，也开始理直气壮地喊人轮流帮忙，不再一个人收拾所有的烂摊子。", lean = "可可回到熟悉的落脚处做事，桌椅不多，来来往往的人她却个个认得。忙不过来就开口喊帮手，“自己人”这三个字，总算也把她自己算了进去。", memorial = "可可认过名字的小纸片夹在名册里，有几张已经看不清字了。大家一起搬桌子、收凳子，手忙的时候总想再喊她一声。最后先把她的名字写好，才添上那些受过她照应的人。" }, yuxiang = { good = "余想带出来的守卫队有一张写得清清楚楚的轮值表。五老压阵的名声让雇主放心，她自己最满意的却是另一件事：每回交班，真有人按时站到她面前。", lean = "余想接着当长矛护卫，签约前先问替班的事。她不靠一个响亮的名号多要钱，也不再让人拿一句“你最稳”无休止地给她加时辰。", memorial = "轮值表在余想最后那一班上划了线，来接班的人认认真真写下了时辰。长矛放回架子，钥匙交到了下一个人手里。她问过无数遍的那句“下一班谁”，这回兄弟们亲口答完了。" }, tongzhu = { good = "童猪的小熊游戏成了集市上的常见节目，越是不服气的人越爱往前凑。有人认出她跟过黑旗，想讨一局重来，她把木熊往前一推：规矩写着呢。", lean = "童猪带着木熊跑小集，赢的钱刚够下一顿。她照旧先把规矩念清楚，偶尔让吹牛的客人当场出个丑，收摊时也照规矩把自己输掉的那份结清。", memorial = "木熊底下那几行规矩被摸得发亮，桌边还记着几位队长输掉的那局。有人照着规矩摆了一遍，笑出了声，又把杯子轻轻放下。再开局的时候，大家先等那一声约好的敲杯。" }, meiya = { good = "美伢领起了一支新的巡演队，大王舞照样热闹。到了谢幕，她会把忙了一整晚的伴舞拉到前头，自己往后退半步。上了就拼，菜了就练，这话还写在她后台的墙上。", lean = "美伢接着跑小场子，上台前先查哪块木板会绊脚。场子再窄，她也给同伴留出转身的地方，等掌声落了，再把布景一起收走。", memorial = "美伢的舞带折好放在行李上，鼓手还记得她纠正过的那半拍。收场的人把过道上的椅子搬开，给忙了一晚的同伴留出位置。说起大王舞，还有人会跟着把她教的步子走一遍。" }, wanshe = { good = "玩蛇的练武场门口挂着老大的名号，场子里却只有几根朴素的木桩。冲着“秦国的神”来的人，往往先被她拉过去纠正脚步，站稳了才许问下一招。", lean = "玩蛇四处找人试招，收不起徒弟就找人对练。招式的名字照样起得吓人，木桩上的刀痕倒是一天比一天实在，为了半寸落脚，她能跟人争到天黑。", memorial = "那几根练习木桩跟破装备收在一起，蛇形的刀痕有深有浅，旧脚印也还在。大谋摸着她反复试过的那一处，想起两人还没争完的那半寸。天黑了，木剑还靠在原地。" }, tutu = { good = "最后那顿饭吃完，涂涂唱完了自己想唱的歌，第二天按说好的时辰出发了。后来她偶尔会寄来下一站的消息，想回来的时候也会回来看看。", lean = "涂涂背着行李接着找能唱歌的地方，路费紧了就多住一晚。她照样认真说好什么时候走，也照样能在另一堆营火边重新坐下来。", memorial = "涂涂留下的曲子里夹着一张下一站的路票，歌词里还有那些说起过的地方。兄弟们唱到那一段，就想起她回来拿手套的那个晚上。歌唱完，纸被平平整整地收好了。" }, naigai = { good = "奶盖在练武场边讲起制胜之道还是滔滔不绝，只是讲完就得自己拿盾上场。熟客专等着听她挨了头一下以后怎么解释，也等着看她笑着把盾重新举起来。盖姐聪明人，这回大家多少信了一点。", lean = "奶盖找了份看货的活，闲了照旧在旁边论武。牛吹大了就会被人拉去比一轮，她输了照样嘴硬，盾却再没偷偷塞给别人拿。", memorial = "奶盖的盾修过不止一回，握带上还有新打的结。兄弟们笑她吹过的那些牛，也记得每回喊她上场，盾总会重新举起来。旧战报夹在盾后面，吹得最凶的那一句，还被她自己画了个圈。" }, xiaojie = { good = "小杰管起了商队的车库，每把备用钥匙都有单独的交接记录。老朋友想凭一句“咱俩熟”就把车推走，也得先签名；等人回来了，她才放心把锁扣上。", lean = "小杰靠修锁看车攒钱，工具一件件添上。有人催，她就把交接单拿出来。她知道少信一句没凭没据的保证，往往能让别人少丢一整车货。", memorial = "备用钥匙一把把拴着小木牌，借还的记录也收得整整齐齐。兄弟们照着她写的名字把工具还回去，最后听见锁扣“咔哒”一声落下。熟人想催两句，看见那本交接单，还是先把自己的名字签上了。" }, bula = { good = "bula把钱袋戏法搬回了小戏台，台下看得直叫，散场后她照旧一枚枚点钱。能给帮手开足工钱，才是她最想表演的那一回“钱袋变厚”。", lean = "bula在集市上变些小戏法，进账不稳就缩减开销。她从不许诺能把空袋子变成一支大军，可分给一起干活的人那一份，总是当面数清。", memorial = "钱袋和账本一起留了下来，同伴的那份照着记录一项项还了回去。桌角那枚变戏法的铜片薄薄的，摸着却让人想起台下那阵惊叫。点钱的人把它另装了一袋，留作纪念。" }, suwa = { good = "苏袜给商队领路，跑到岔口会先停半步，让后面的人看清路标。她还是走得快，只是现在一回头，总能等来一整支队伍。跑得快的那些人照旧叫她袜神。", lean = "苏袜跑起了附近的送货路，拐弯前把记号做得大一些。抢来的那半步不再全花在自己身上，等人看明白了再走，反倒少回头找了好多回。", memorial = "苏袜留下的岔口记号画得急，却很清楚，人走的和车走的各有一条线。兄弟们照着走过去，回头还能看见后来的人跟上。那个总想快半步的人留在路上的记号，倒一直在等着大家。" }, qianhan = { good = "千涵在短坡上带人练跑，003的号码缝回了旧衣服上。有人又把她说成传奇，她一边纠正一边示范呼吸：先把这一段跑好，再谈你还没到的终点。", lean = "千涵靠跑腿干活，歇下来照旧分段练呼吸。003没变成什么响亮的名号，她也不着急，每跑完一段就记一次，认真得让同行的人不好意思偷懒。", memorial = "003的号码平平整整地缝在布页上，练习簿边记着她跑完的那几段。空格还剩几处，填过的都看得清清楚楚。兄弟们拿那根量距绳重新量了一遍坡道，把起点留在她站过的地方。" }, wangdazhi = { good = "王大芷搭起新戏的幕布，也把自己的名字写进了节目单。谢幕时她走到台前，等掌声真落到自己身上了，才回头招呼还在忙活的同伴。", lean = "王大芷给小戏班撑场子，挣得不多，节目单上却总留着芷芷的位置。她能把幕布撑稳，也会开口提醒一句：这一段，该我上了。", memorial = "节目单摊开，王大芷的名字就在她自己改过的那个位置上，旁边还写着“芷芷”。兄弟们说起她救场的本事，也说起她终于走到幕布前头的那一回。收起节目单前，有人又把那一行轻轻念了一遍。" }, yaoyaoya = { good = "瑶瑶牙在比武场上出手还是那么干脆，“奶团吕布”的叫好声一响，她先瞥一眼同伴的旗。赢完这一场，还有人跟她一起回去。", lean = "瑶瑶牙接些短途护卫的活来养着练武，名号照样有人喊，步子却收得住了。有人激她单枪匹马追出去，她先回头确认队伍还在，再决定这一斧该不该劈。", memorial = "确认位置用的小旗收进了布套，长斧靠在旁边。兄弟们记得她劈开的那些缺口，也记得她每回出手后回头看旗的样子。旧挑战书压在护送安排底下，次序还跟她放下时一样。" }, yangmiemie = { good = "羊咩咩在熟路上做起了送货生意，过弯前铃铛先响。客人夸她送得快，她先把包裹打开给人看：东西完完整整地到了，这一趟才算跑完。", lean = "羊咩咩推着小车接零散的包裹，碰上长坡就提前留力。那只铃铛算不上什么英雄的号角，却能让路边的人知道，有一件被好好护着的东西快送到了。", memorial = "小铃挂在车把旁，待送包裹的封口又查了一遍。兄弟们替她把剩下的路送完，在回执上签了自己的名字。回来收车时，铃轻轻响了一声，像她过弯前的那声提醒。" }, songnuanyang = { good = "宋暖阳把旅途笔记整理成了一本薄册子，打赢的、打输的都写在里头。有读者嫌最后一页不够漂亮，她把鹌鹑纹兜帽缩了缩，还是把那个没问完的问题印了上去。", lean = "宋暖阳替过路的人写信，闲了才抄自己的笔记。纸不够了就把字写小，那几天打败仗的记录却一页也没撕。有人问起黑旗，她先讲自己亲眼见过的。", memorial = "暖阳的最后一页停在半句话上，页边那只小鹌鹑也只画了一半。兄弟们读完那些胜仗和败仗，把自己知道的事另写在后面。翻回她的字迹时，那个还没问完的问题，还留在原处。" }, xiaogui = { good = "溺水小龟把自己的战绩牌挂得端端正正，逢人就讲这是哪一仗。夸飞爹的话照样说得响，可讲到最要紧的那一下，用的是她自己的名字。", lean = "溺水小龟背着壳接些短途的活，那只亮粉色的蝴蝶结照旧系得精神。战绩牌没有传说里那么夸张，她照样一条条记着，等碰见熟人就拿出来给人看。", memorial = "小龟的战绩牌收在名册旁边，亮粉色的蝴蝶结也系得整整齐齐。牌上写的是她自己的名字，一仗一仗都记着。阿飞坐了很久，把她亲手画好的下一步摊开，又看了一遍。" } } };
