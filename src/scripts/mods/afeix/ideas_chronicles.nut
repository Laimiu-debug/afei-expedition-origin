// These are authored fictional scenes. NPC contacts do not create roster actors.
local A=::AfeixExpedition;
A.Chronicles <- {
    liu={title="传奇儿飞派，也查维修账",text="酒馆角落有人抬了抬手：‘飞爹，这儿。’\n\n阿飞看清是刘青松，领口都挺直了三分。对方先把一包药、一捆工具摆上桌，再打量了一眼阿飞的盾。\n\n‘都说你扛得住。’\n\n‘那是。’\n\n‘盾也这么想？’\n\n阿飞把盾上那道凹痕悄悄转向墙。刘青松没拆穿，只把东西推近：‘挑一份。我还赶路，不跟你出征。下次脸和盾分工明确点，别总互相代班。’",choices=["先照顾脸，毕竟还得靠它撑场面。（药品 +4）","先修盾，争取让脸早日退居二线。（工具 +6）"],
        outcomes=["刘青松把药递过来：‘行，保护一下咱们飞爹最贵的地方。’\n\n阿飞正要得意，对方又补一句：‘主要是修起来费嘴。让你歇一会儿，得劝半天。’\n\n阿飞把药仔细收好，终于没还嘴，只问他路上带够吃的没有。", "工具落在桌上，发出很扎实的一声。阿飞拍拍盾：‘听见没有，你要升职了。’\n\n刘青松笑着起身：‘它一直在干活。你以后记得让它站前面。’\n\n送人到门口时，阿飞真把盾往前挪了挪。这一次没人催。"]},
    liu_reply={title="夸奖限量，复盘管够",text="再遇刘青松，阿飞把战报摊得很平，特意让‘胜’字朝着对方。\n\n刘青松看了一眼：‘赢了，不错。’\n\n阿飞还等着下句。\n\n‘夸完了。这个位置，为什么没人跟？’\n\n他点中了阿飞原本打算用酒杯压住的那一段。阿飞把杯子挪开，挪了两回，索性一口喝了，把空杯倒扣到桌边。\n\n‘行，今天你讲。但刚才那个不错，等会儿能不能当着大家再说一遍？’",choices=["先把挨打的地方讲明白，再补一句夸的。（全队心情 +0.25）","叫大家坐近点，有问题一起挨批。（全队心情 +0.25）"],
        outcomes=["刘青松把那几步拆开讲，阿飞一边点头，一边往旁边腾出空白。等战报上画满箭头，他抬眼提醒：‘到那句了。’\n\n刘青松憋着笑，把‘打得不错’又说了一遍。门边听了半天的人终于笑出声：飞爹这回没白挨批，也没漏领夸奖。", "凳子一张张挪过来，大家先抢着说自己没听清哪声令，后来连谁把路让窄了也认了。\n\n阿飞居然记得最认真。刘青松合上战报时，他问：‘明白了，下回怎么少挨这些？’\n\n‘先照你刚记的做。’阿飞低头一看，本子上记得最满的那页，全是他自己的毛病。"]},
    er_xiaoyuan={title="飞爹今日，忍住没抢答",text="小原的信里又夹着一张问题纸。这回最上头写着：团长听完别人一句话，打一个勾。\n\n阿飞提笔，先给自己打了三个。随后看见底下那行小字：自己跟自己说的不算。\n\n他盯着那三个勾看了很久，最终把纸转过来，在背面认真写起最近一次被队员提醒的经过。写到‘我当时其实已经想到了’，笔又停了。",choices=["把‘其实已经想到’划掉，这句算他的。（阿飞心情 +0.25）","换人先讲，我今天试试不抢答。（阿飞心情 +0.25）"],
        outcomes=["那句话被划掉以后，整段经历短了一半，反倒好懂了。阿飞看着剩下几行字，给真正提出主意的人添上姓名。\n\n最后他还是在纸角给自己画了一个小勾：这次总该算忍住了。", "阿飞把笔放到桌子对面，自己端着水等。讲到一半，他几次张嘴，最后都变成喝水。\n\n听完以后他只问了一个问题，居然正好问到点上。纸上的第一个勾，这回是别人替他画的。"]},
    er_haman={title="包赢这两个字，先赊着",text="哈曼的回信把一句‘下次包赢’圈了出来，旁边只写了三个字：谁担保？\n\n阿飞先写‘我’，想了想又添上‘尽量’。这下成了‘我尽量担保’，连他自己看着都觉得靠不住。\n\n桌边压着旧契约，做成的、没做成的都在。阿飞把那面写得很气派的旗挪开一些，免得它老挡着纸。",choices=["别润色了，没做到的照实写。（阿飞心情 +0.25）","把包赢改成三件真能办的事。（阿飞心情 +0.25）"],
        outcomes=["阿飞把解释写完，才发现最难看的那一行并没有把整封信毁掉。相反，后面的打算终于有地方落笔了。\n\n封信时，他特意没拿‘路上太忙’当理由。那句平时最好用，今天最好不用。", "纸上最后留下三件事：先点清人数，先说明信号，有人没听懂就再讲一遍。\n\n阿飞读完，觉得少了点威风，于是在落款处把名字写得很大。事情没再夸口，排场姑且从这里找补。"]},
    er_sige={title="第四张凳子，不放团长的脚",text="四哥那张空凳的旧事又被翻出来。营火边正好四张凳子，阿飞坐了一张，行李占了一张，他的脚还很自然地搭着半张。\n\n读到信里‘给还没开口的人留个位’，他低头看了看自己的靴子。\n\n片刻后，行李落地，脚也落地。阿飞拍拍空凳：‘坐。今天先听你说。’\n\n对方第一句话是：‘您刚才把烤饼挡住了。’",choices=["行，先让饼出来，再让话出来。（阿飞心情 +0.25）","坐近点，今天不用隔着团长的靴子说。（阿飞心情 +0.25）"],
        outcomes=["饼传到手里，大家终于坐成了一个像样的圈。有人提意见，有人补一句，阿飞想讲的话反而越攒越少。\n\n写给四哥的记录里，他郑重添了一条：那张凳子很好用，前提是上面没有脚。", "凳子往火边挪，阿飞把膝盖收进去一点。原本只准备说两句的人，最后把整段难处都讲完了。\n\n阿飞没急着下结论，先递过去半张饼。剩下的话，看来还得再坐一会儿。"]},
    er_keke={title="保可梦，今天拒绝出球",text="可可那张便笺又从名册里滑出来，旁边还画着个圆圆的球。阿飞一边看一边念：‘自己人嘛，我一招手——’\n\n下一行恰好写着：也可以说不。\n\n他的手停在半空，最后变成挠头。那个小小的圆球被画得很神气，阿飞看了半天，觉得它简直像在等一句说得过去的请求。",choices=["先问愿不愿意，球盖又不是军令。（阿飞心情 +0.25）","那我负责把理由说好，不能光喊自己人。（阿飞心情 +0.25）"],
        outcomes=["阿飞在便笺背后写下‘你愿意吗’，原本顺手要补的‘肯定愿意吧’也被划掉了。\n\n写完再看，那个圆球仿佛顺眼了不少。他把纸收回名册，决定以后先听答案，别忙着替人开盖。", "他把‘自己人帮一下’拆成了要做什么、哪里危险、能得到什么，又把最后一项改得更实在。\n\n纸写满了，事情倒没那么难开口了。阿飞小声嘀咕：‘这球还挺难哄。’这回却没有不耐烦。"]},
    er_xiaogui={title="头盔格局小，战报不能小",text="小龟的旧战报边上画着一个头盔，头盔下面是一个明显更大的圆脑袋。批注写得很严肃：不是头的问题，是头盔格局小了。\n\n阿飞看得笑出声，翻到背面，却发现那里认真记着一次没判断好的进退。纸上预留的评语位置空着，像是在等一句比‘壳真硬’更有用的话。\n\n他提笔写了个‘猛’，看看，又划掉了。",choices=["壳替你扛过了，这步棋咱们再看看。（阿飞心情 +0.25）","头盔的事怪铁匠，判断的事认真聊。（阿飞心情 +0.25）"],
        outcomes=["阿飞沿着战报上的路线重新画了两步，旁边写：这里晚一点出手，后面就不用硬吃。\n\n最后他还是没忍住，在那顶小头盔旁添了四个字：建议扩建。可真正留在评语栏里的，总算是一条能用的提醒。", "他把当时能看见的敌人和猜到的敌人分开圈出来，发现最要紧的，恰好是中间没写清的那一步。\n\n阿飞补了一个问号，没有急着代答。至于铁匠，他在旁边替人留了一句公道话：工钱不能按头围算。"]},
    er_yuchujiu={title="停字很大，面子先放小",text="初九那张写着‘停’的旧纸条，总在阿飞翻名册时最先露出来。他怀疑是折得太厚，展开一看，只不过那个字写得实在太大。\n\n阿飞试着在背面添一条团长规矩：叫停时请注意场合。写到一半，他又想起真有危险时，哪来工夫挑个好听的说法。\n\n笔尖在纸上悬了片刻。",choices=["先把我叫住，面子回头再补。（阿飞心情 +0.25）","停可以，停下以后咱们把下一步讲清。（阿飞心情 +0.25）"],
        outcomes=["那条新规矩被划掉，改成：喊大声点，别让我装没听见。\n\n阿飞看着‘装’字，自己先笑了。他把纸条折回原样，那个大大的停字仍露在外面，这回倒不用再往里塞了。", "背面多了一个箭头，箭头后留着足够两个人写字的空白。\n\n阿飞把纸压平。谁先看见危险谁先喊，等停稳了，再一起商量往哪边走。"]},
    route_toad={title="冲得最响，回头别最晚",text="阿飞正在复述自己怎么打开那道缺口，讲到兴起，连地上的石子都被摆成了敌阵。\n\n一个跟上来的队员把另一颗石子放到他背后：‘您冲到这儿的时候，我们在这儿。’\n\n阿飞看看两颗隔得有点远的石子，嘴里的第三遍‘然后我一下’忽然没接上。\n\n他把代表自己的那颗推回一点：‘那下回呢？’",choices=["我负责开口子，也得给你们留条跟上的路。（阿飞心情 +0.25）","先定个信号，总不能只听我哇哇叫。（阿飞心情 +0.25）"],
        outcomes=["几颗石子重新摆过，阿飞那一下还是很威风，只是现在后面跟得上人了。\n\n他讲完以后，照旧问刚才帅不帅。有人说帅，末了又补一句：‘留路那步尤其帅。’这句夸得他比前面几句都受用。", "你们约好一个短促、明确的跟进信号。阿飞演练一遍，旁边立刻有人指出：这个听起来像刚才夹到手。\n\n于是又换了一个。等大家终于能分清军令与团长的个人感受，天已经暗了一点，阿飞却觉得这工夫花得值。"]},
    route_jiahao={title="旗够大，别挡着别人",text="有人来问最后那一击是谁打的。阿飞下意识整了整领口，向那面大旗挪了半步。\n\n真正出手的队员正站在他背后，恰好被挡得严严实实。阿飞回头一看，咳了一声，又往旁边挪了半步。\n\n来人仍看不见。\n\n阿飞低头看了看披风，干脆连人带披风往旁边让开：‘来，今天你站这儿。’",choices=["名字记他的。人是我带来的，这也够吹了。（阿飞心情 +0.25）","给他找张凳子，我站旁边替他扶旗。（阿飞心情 +0.25）"],
        outcomes=["对方把名字记下时，阿飞果然还是补了那句‘我带来的’，但谁也没嫌他多嘴。\n\n被夸的人讲得有些拘谨，他就在旁边把事情一段段接起来。这次那张名册上多了另一个醒目的名字，阿飞看得很满意。", "凳子摆好，旗子也扶稳了。阿飞站在旁边，忽然发现不用抢着说话，也能听到不少让人高兴的事。\n\n风把旗角吹到他脸上，他伸手拨开，小声嘀咕：‘回头还是得改改这尺寸。’旗前的人终于笑得自然了。"]},
    route_feidie={title="飞爹降落，请勿占用饭桌",text="阿飞踩上凳子，准备发表一段配得上‘飞爹’称呼的讲话。底下的人仰头看着他，他很满意。\n\n‘大家有什么想问的？’\n\n一只手举起来：‘您踩的是我等会儿吃饭的凳子吗？’\n\n第二只手：‘明天从哪条路走？’\n\n阿飞望望脚下，又望望地图，忽然觉得先处理第二个问题，或许还能挽回第一个问题的气势。",choices=["降落，开饭，地图铺这边。（阿飞心情 +0.25）","先准许大家提意见，包括凳子的意见。（阿飞心情 +0.25）"],
        outcomes=["阿飞把凳面擦干净，自己先坐到旁边，拿几粒豆子摆出明天的路线。\n\n有人把代表山口的那粒吃了，他只好又添一粒。讲到最后，大家既知道了往哪走，也知道了为什么要等补给——因为地图上的后勤已经被吃掉两回了。", "意见比阿飞想的多：路太绕、盾带该换、上次的军令没听清，还有凳面确实得擦。\n\n他一条条听完，没有因为有人喊了飞爹就跳过哪条。最后自己补上一条：下次讲话，就在地上。"]},
    bottle_daily={title="带人之前，先扶好车",text="小酒瓶蹲在旧车旁，把松掉的链条一点点往回挂。阿飞站在旁边，正讲到当团长得会带人。\n\n她没抬头：‘说得挺好，先带我把这边扶住。’\n\n阿飞伸手扶车，还想继续讲，车轮忽然转了一下，他立刻‘哇’了一声。\n\n小酒瓶这才抬眼：‘很好，人还醒着。扶稳，别用道理扶。’",choices=["今天我当车架，你指挥。（两人心情 +0.25）","要不我来装？……你先别松手。（两人心情 +0.25）"],
        outcomes=["阿飞扶得很认真，连夸自己的话都暂时腾不出嘴说。链条终于扣回去，小酒瓶轻轻摇了一下车铃。\n\n‘行，这回带得不错。’\n\n阿飞正想接话，她又指指另一边：‘还有这儿。’他叹口气，手却已经换好了位置。", "两人换了个位置。阿飞把链条挂回去一半，又掉了；小酒瓶笑着提醒他慢点，没伸手抢。\n\n第三次终于稳稳卡住，阿飞转了转轮子，得意地抬头。她递来擦手的布：‘知道了，飞队维修部今天开张。’"]},
    bottle_after={title="这回，没人替你扶车",text="营里有人试了一下小铃铛，阿飞下意识回过头，话已经到了嘴边：‘瓶队，你看——’\n\n后半句没说出来。\n\n他站了一会儿，低头看了看早已洗净的手，忽然又想起那句‘别用道理扶’。当时自己还嫌她拆台，现在倒把每个字都记得很清楚。\n\n身后有人问什么时候出发。路还是那条路，今天得由他自己回答。",choices=["把这句也记下，省得以后又只会讲道理。（阿飞心情 +0.25）","先帮大家抬行李，话等上路再说。（阿飞心情 +0.25）"],
        outcomes=["名册里多了一行很短的话。阿飞没有写得很漂亮，还在旁边画了一个不像车轮的圆。\n\n看了半天，他自己笑了一下，把本子收好，起身去帮人扶车。", "阿飞没站上高处喊准备，先弯腰托住箱子的另一头。对面的队员愣了一下，赶紧一起用力。\n\n箱子稳稳上车，队伍开始挪动。阿飞走在旁边，想说的那句话终于换成了：‘这边我扶着。’"]}
};
A.chronicleScene <- function(key){
    return key in this.Chronicles?this.Chronicles[key]:null;
};
A.nextChronicle <- function(){
    if(!this.ideaSafe()||!this.canManage()||!this.ideaAlive(this.findCharacter("afei"))||this.worldNow()<this.get("ideas_chronicle_next"))return "";
    local town=this.currentTown(),wins=this.get("ideas_wins");
    if(town!=null&&!this.get("chronicle_done_liu",false)&&(this.get("ideas_er_gift",false)||this.progressCount()>=6))return "liu";
    if(town!=null&&this.get("chronicle_done_liu",false)&&!this.get("chronicle_done_liu_reply",false)&&wins>=this.get("ideas_liu_wins")+3)return "liu_reply";
    if(wins>=1)foreach(id in this.RootOrder)if(this.get("root_done_"+id,false)&&!this.get("chronicle_done_"+id,false))return id;
    local route="route_"+this.route();
    if(wins>=2&&route in this.Chronicles&&!this.get("chronicle_done_"+route,false))return route;
    if(this.get("growth_done_bottle",false)&&this.ideaAlive(this.findCharacter("bottle"))&&wins>=2&&!this.get("chronicle_done_bottle_daily",false))return "bottle_daily";
    if(this.get("bicycle_state")==4&&!this.get("chronicle_done_bottle_after",false))return "bottle_after";
    return "";
};
A.resolveChronicle <- function(key,choice,token){
    if(!(key in this.Chronicles)||choice<0||choice>1||this.get("chronicle_done_"+key,false)||!this.ideaAlive(this.findCharacter("afei")))return this.result(false,"这段故事已记录，或当事人此刻不在队。 ");
    local ending=this.Chronicles[key].outcomes[choice];
    if(key=="liu") {
        local reward=choice==0?{kind="medicine",amount=4}:{kind="tools",amount=6};
        try{this.grantStoryReward(reward);}catch(e){return this.result(false,"公共储备装不下整份补给；腾出容量后可再来会面。");}
        this.set("ideas_liu_wins",this.get("ideas_wins"));ending+="\n\n获得 "+this.storyRewardText(reward)+"。刘青松继续自己的旅途。";
    } else if(key=="liu_reply")this.ideaMood(this.roster(),0.25,"刘青松陪黑旗复盘");
    else if(key=="bottle_daily"){
        local b=this.findCharacter("bottle");if(!this.ideaAlive(b))return this.result(false,"小酒瓶此刻不在队中。");
        this.ideaMood([this.findCharacter("afei"),b],0.25,"一起修好车链");
    } else this.ideaMood([this.findCharacter("afei")],0.25,"把走过的路记在心里");
    this.set("chronicle_done_"+key,true);this.set("chronicle_choice_"+key,choice);
    this.set("ideas_done_token",token);this.set("ideas_chronicle_next",this.worldNow()+this.daysInSeconds(2));this.refreshAssets();
    return this.result(true,ending);
};
A.hasIdeaRecords <- function(){
    if(this.get("ideas_gift","")!=""||this.get("ideas_cao_until")>0||this.get("ideas_hurt_open",false))return true;
    foreach(key,d in this.Chronicles)if(this.get("chronicle_done_"+key,false))return true;
    return false;
};
A.ideasLedgerPage <- function(event,page){
    local parts=split(page,":"),kind=parts[0];if(kind!="ideas"&&kind!="ideas_read"&&kind!="journey_index")return null;
    local s=this.storyScreen(page);
    if(kind=="journey_index"){
        s.Text="旅途旧事\n\n走过的路、遇过的人，都记在这儿。";
        if(this.hasStoryRecords())s.Options.push(this.ledgerNav("伙伴成长与旧事","growth"));
        if(this.hasIdeaRecords())s.Options.push(this.ledgerNav("路上的消息与相遇","ideas"));
        s.Options.push(this.ledgerNav("返回名册","home"));return s;
    }
    if(kind=="ideas_read"&&parts.len()>1&&parts[1] in this.Chronicles&&this.get("chronicle_done_"+parts[1],false)) {
        local key=parts[1],d=this.chronicleScene(key),choice=this.get("chronicle_choice_"+key);
        s.Text=d.title+"\n\n"+d.text+"\n\n当时选择："+d.choices[choice]+"\n\n"+d.outcomes[choice]+"\n\n此为旧事记录，重读不再结算。";
    } else {
        s.Text="路上的消息\n\n这里保存已经走过的相遇与回信。";
        local pending=this.get("ideas_gift","");
        if(pending!=""){
            s.Text+="\n还有一份"+(pending=="bao"?"保飞派":"儿飞派")+"补给待领取。";
            s.Options.push(this.ledgerAction("领取留下的补给",function(){local A=::AfeixExpedition,k=A.get("ideas_gift","");if(!A.canManage()||k==""||!A.ideaGiveGift(k))return A.result(false,"请在安全地点，腾出一个行囊空位及足够医疗储备容量。");A.set("ideas_gift","");return A.result(true,"整份补给已领取。");},"ideas"));
        }
        if(this.get("ideas_cao_until")>this.worldNow())s.Text+="\n曹飞派的热血尚在：阿飞亲自出战时启用。";
        if(this.get("ideas_hurt_open",false))s.Text+="\n儿飞派还在等飞爹养好伤。";
        local known=[];foreach(key,d in this.Chronicles)if(this.get("chronicle_done_"+key,false))known.push(key);
        known.sort();local offset=parts.len()>1?this.storyPageNumber(parts[1]):0;
        if(offset<0||offset>=known.len())offset=0;
        local n=::Math.min(3,known.len()-offset),window={offset=offset,count=n,more=known.len()>3,next=offset+n>=known.len()?0:offset+n};
        for(local i=window.offset;i<window.offset+window.count;++i)s.Options.push(this.ledgerNav(this.Chronicles[known[i]].title,"ideas_read:"+known[i]));
        if(window.more)s.Options.push(this.ledgerNav("翻到另一页","ideas:"+window.next));
    }
    s.Options.push(this.ledgerNav("返回名册","home"));return s;
};
