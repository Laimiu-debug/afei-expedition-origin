// Generated by tools/build_backgrounds.py from data/character-backgrounds.json.
::AfeixExpedition.CharacterBackgrounds <- {
    afei = { name = "黑旗发起人", description = "在立起这面黑旗之前，阿飞走过不少地方，干过不少营生，哪一样都没干长。他嗓门大，主意多，会讲，也会吹。等他终于凑齐三张凳子、挂出一面旗，才发现带人和吆喝完全是两回事。" },
    damou = { name = "游历盾师", description = "王大谋在各地的练武场里混过好些年，给商队当过护卫，也在比武台上挨过不少揍。挨揍的时候他记性最好，谁打的、怎么打的，回头都要找人请教。那面盾用了好些年，裂了补，补了再裂。" },
    mocha = { name = "随军账房", description = "抹茶早年给好几支队伍管过钱粮，亲眼见过佣兵团是怎么被一笔笔糊涂账拖垮的。他读的书杂，记性又好，大小事都能说出个来龙去脉。他不爱往前线凑，可哪支队伍没了他，半个月就得揭不开锅。" },
    bottle = { name = "球场突击手", description = "小酒瓶是在集镇的泥地球场上长大的，打小就跟一群男孩抢球，抢输了也不哭，下一脚踢得更狠。镇上办比赛，她一个人进的球比整队都多。后来球场散了，她揣着一只旧球、推着一辆破自行车出了门。" },
    shuaizi = { name = "营门鼓手", description = "白小帅子在临时营地里敲过好几年集合鼓。她胆子不大，夜里风吹帐篷都能吓一跳，可鼓点从没乱过。有一回营地遇袭，她一边掉眼泪一边把鼓敲完，硬是把跑散的人全叫了回来。" },
    lili = { name = "巡演射手", description = "李李跟着巡演班子走南闯北，靠一手射箭的把式讨生活。她知道观众爱看什么，什么时候该亮相，什么时候该装作失手再补一箭。班子散伙那天，她只带走了一张弓和一把高背椅。" },
    xiaoyueya = { name = "杂货改造匠", description = "小月牙在集市上守过一张什么都卖的杂货桌。别人扔掉的东西，到她手里总能改出点用处，当然改坏的也不少。她卖东西靠一张嘴，进货靠一双专捡破烂的眼睛。" },
    yuchujiu = { name = "巡队哨手", description = "余初九在商队里当过好几年哨手，专管岔路和队尾。她嗓门大得出奇，一声喊能传出半里地。商队的人嫌她吵，可那几年跟着她走的车，一辆都没丢过。" },
    xiaoyubeike = { name = "栈桥护卫", description = "小鱼贝壳在码头栈桥上当过护卫，管的是货车挤成一团时谁先走、谁后走。码头上的苦力都服她，因为每回出事，她总是头一个顶上去。她话不多，抡起锤子来倒是很有说服力。" },
    wangduidui = { name = "口信核验员", description = "王怼怼在集镇驿站里核过几年口信。传错一句话，就可能有一队人去错地方，这种事她见过太多回了。所以不管谁来传话，她都要先问三件事：去哪儿，干什么，谁接应。" },
    laocai = { name = "护队参谋", description = "老蔡给护送队当过参谋，管看地形、排接应。他见过太多计划在一座断桥前散了架，所以排兵布阵之前总先想最坏的情况。他话少，说出来的多半不是好消息，可往往是对的。" },
    yanzi = { name = "营地调解人", description = "眼子在几支佣兵队之间当过中间人，替人传话、对账、劝架。他嘴皮子利索，一句玩笑就能把剑拔弩张的场面拉回来。不过玩笑归玩笑，账他是一定要对清的。" },
    tiantong = { name = "蓝旗信使", description = "小虎背着蓝旗信袋跑过好几年驿路。别的信使送到镇口就交差，她非得送到收信人手里才算数。为这个，她多跑过不少冤枉路，也挨过掌柜不少白眼。" },
    xiaoning = { name = "怪图向导", description = "小宁靠给旅人画路图挣盘缠。她的图谁也看不懂，可跟着她走，十回里总有几回能抄到别人不知道的近路。剩下那几回，就不好说了。" },
    xiaopangxu = { name = "街头舞者", description = "小胖在街边空地上跳舞讨赏钱，鼓点一起，脚就停不下来。路人踢翻水桶的声音，她都能接进舞步里。至于赏钱到底挣了多少，她自己一直没数明白。" },
    dae = { name = "营地守位人", description = "大鹅在大营地里看过门、占过座，谁的位置谁的铺，她心里一清二楚。想抢地方的人，先得过她那一嗓子。她脾气不小，可从没让哪个自己人回来没地方坐。" },
    manyuemei = { name = "红线督战员", description = "蔓越莓给几支演练队排过站位。她用一根红线把场地分得清清楚楚，谁先上、谁后补，一句废话没有。她不爱重复，真要说第二遍的时候，眼神比话还急。" },
    xiaohani = { name = "随行藏粮人", description = "罗一可跟着商队护送过不少趟，身上总挂着好几只小布袋，干粮、针线、路费各装各的。路上断过粮，所以她总比别人多藏一份。大家叫她仓鼠，她也认。" },
    keke = { name = "结伴守望者", description = "可可在商旅落脚的地方帮人认朋友、腾座位，来来往往的人她见一面就能叫出名字。她身边总围着一群人，大多是她顺手照应过的。赶路时她习惯走在侧后，好看着掉队的人。" },
    yuxiang = { name = "轮值长枪卫", description = "余想在城门岗上守过好些个长夜，长矛立得稳，人也站得住。长官总说她最让人放心，于是夜岗一班接一班地落在她头上。她后来学会了一件事：先问清楚下一班是谁。" },
    tongzhu = { name = "木熊游戏主持", description = "童猪在酒馆里主持过桌边游戏，一只木熊、几条规矩，就能让一桌大老爷们争得面红耳赤。她最爱看自以为聪明的人猜错，猜错了还不认的，她更爱看。" },
    meiya = { name = "巡演领舞", description = "美伢在宴厅和集市的临时舞台上领过好些年舞。她跳得热闹，眼睛却一直在看台上的人：谁要撞上了，谁要掉拍了。散场后她总是最后一个走，把被忘在角落的人一起叫上。" },
    wanshe = { name = "蛇步试招客", description = "玩蛇四处踢馆试招，走过的练武场比她自己记得的还多。她给每一招都起个响亮的名字，再在木桩前一遍遍验到站得住为止。输了不恼，记下来，下回再来。" },
    tutu = { name = "行旅歌者", description = "涂涂带着一把琴和一叠路票，走过不少营火。唱完一晚，有时第二天就走，有时多住几天。她认识的人多，留下的人少，下一站去哪儿，向来是她自己定。" },
    naigai = { name = "街头论武客", description = "奶盖在练武场边上讲过好几年武，讲得头头是道，围观的人都爱听。真有人递盾让她下场，她多半退得比讲得快。不过退完了，她总还会再上去一次。" },
    xiaojie = { name = "车锁看守", description = "小杰替商行看过货车和仓门，钥匙一串串挂在腰上，走起路来叮当响。谁借了什么、什么时候还，她都记在本子上。她最不信的一句话就是“都是熟人”。" },
    bula = { name = "钱袋戏法师", description = "bula在小戏台上变过钱袋戏法，一抖一倒，钱袋就像变厚了一圈。台下叫好，她心里清楚，戏法变不出饭钱。散场后，她总把真正的进账一枚枚数清。" },
    suwa = { name = "踩点斥候", description = "苏袜替旅队探过路，哪条路近、哪个弯急，她腿上比纸上记得清楚。她跑得太快，常常前面已经探完了，后面的人还没出发。" },
    qianhan = { name = "坡道跑手", description = "千涵在短坡赛上跑过几年，也替人跑腿送东西挣钱。她报名报得晚，号牌排到了003。她把这块号牌擦得发亮，每跑完一段就在本子上记一笔。" },
    wangdazhi = { name = "搭台护场人", description = "王大芷跟着流动戏班撑过幕布、顶过架子。台上一乱，总有人喊“芷芷，搭把手”。她救过不少场，自己的节目却总被挤到最后。" },
    yaoyaoya = { name = "演武破阵手", description = "瑶瑶牙在公开演武里挥过长斧，个子高，出手狠，围观的人都喊她奶团吕布。挑战书收了一大摞，可她更在意的，是答应下来的差事有没有办好。" },
    yangmiemie = { name = "铃车快递员", description = "羊咩咩推着一辆挂铃铛的小车送过不少包裹。铃铛响得不对，她就知道车上哪儿松了。别人送货比快，她比的是东西到手时还完不完整。" },
    songnuanyang = { name = "鹌鹑记事员", description = "宋暖阳在集市上替人写信、记行程，兜帽上绣着鹌鹑纹。外头一有响动她就缩一下，缩完了又探出头来接着问。她写的东西不一定好听，但都是真的。" },
    xiaogui = { name = "背壳小将", description = "溺水小龟的脑袋太大，普通头盔根本塞不进去，好在背上那副壳够硬。她在河边的小比赛里赢过几回，奖品都是些不值钱的小玩意儿，她一样样收得好好的，就等着哪天拿给飞爹看。" },
};
