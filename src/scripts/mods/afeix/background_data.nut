// Generated by tools/build_backgrounds.py from data/character-backgrounds.json.
::AfeixExpedition.CharacterBackgrounds <- {
    afei = { name = "黑旗发起人", description = "招募旗是他亲手立的，“嘉豪”也是他亲手描的，举盾的本事还得请伙伴教。几张凳子凑出三位队长，一面黑旗便有了远征团的名字。喊来的人越来越多，他得学会把这面旗真正撑住。" },
    damou = { name = "游历盾师", description = "练武场和护送队都留过他的脚印。见到好招式就想学，见到好手就想请，同行的桌子越凑越大。如今黑旗前排由他先撑着，那个还举不稳盾的团长，也被他算在自己人里面。" },
    mocha = { name = "随军账房", description = "他替短途队伍管过粮钱，也追过一笔笔被忘掉的欠账。旧算盘拨得响，漂亮保证便很难蒙混过去。黑旗有三位队长，总得有一个记住：明天再大的阵仗，也得先让今天的人吃上饭。" },
    bottle = { name = "球场突击手", description = "集镇球场教会她接球、找空当，也教会她记住是谁把机会交到自己手里。伙伴叫她蛤妈，她笑着应，却仍要争自己的下一场。球能传出去，胜负心可没打算寄放在别人那里。" },
    shuaizi = { name = "营门鼓手", description = "她替临时营地打过集合鼓，也数过夜归的人。四声鼓点敲完，比十句“放心”都管用。怕响动的鼓手总多留一盏灯，等队尾回来，才肯落下门闩。" },
    lili = { name = "巡演射手", description = "她随巡演队展示箭术，知道哪一刻亮相最抓眼，也知道失手后该怎样收势。高背椅是排场，“超巨”是名号。观众肯不肯留下再看一轮，还得由她拉弓来说。" },
    xiaoyueya = { name = "杂货改造匠", description = "她守过一张什么都能摆的杂货桌，旧零件到了手里，常能换个用途再卖。招牌写得大，摊子未必大；东西试坏了，她便翻个面，琢磨第二种做法。" },
    yuchujiu = { name = "巡队哨手", description = "她跟着行路队伍盯过岔口，也守过队尾，人头比战利品记得熟。提醒喊得像吵架，越是熟人越别想拿“差不多”搪塞。该回来的人没到齐，她总有下一句要问。" },
    xiaoyubeike = { name = "栈桥护卫", description = "栈桥挤满货车时，她惯于先举盾腾出一块地方，让后面的人能动起来。“大哥”是同伴的玩笑，顶上去是她自己的习惯。借来的那口气总要缓回来，盾边也得有人接。" },
    wangduidui = { name = "口信核验员", description = "她替集镇核过集合口信，传令牌背面刻着三个问题：去哪儿、做什么、谁接应。歪王冠有人递，糊涂话却没人能递过去。团长再威风，也得先把安排讲清。" },
    laocai = { name = "护队参谋", description = "他受雇替护送队看地形、排接应，地图上的木旗从不把空位占满。桥断了、队尾慢了，总得还有一步可走。留在险处的那面旗，他习惯先写上自己的名字。" },
    yanzi = { name = "营地调解人", description = "他在几支佣兵队之间转交过口信，也核过交接。先让人放下棍子，再把清单摊开，是他惯用的办法。笑话能缓和场面，少掉的东西却仍要查，答应的那一段也得有人签名。" },
    tiantong = { name = "蓝旗信使", description = "蓝旗信袋陪她跑过驿路，封口查完还要查落款。大家叫她小虎，她更在意那句“送到了”落在谁身上。袋底还有未交清的信，回程时便多一次确认。" },
    xiaoning = { name = "怪图向导", description = "她靠画路图挣盘缠，图上的河道常像面饼，漏掉的转角还得本人补讲。旅人喊她外星人，她想入神了顾不上擦嘴。怪图有时绕远，有时也真带人抄到了近路。" },
    xiaopangxu = { name = "街头舞者", description = "她在街边空地练舞，最爱卡住鼓点转身，连倒桶都能接成下一拍。举盾以后，落脚和重心得重新学。阿飞那套嘉豪步伐，正好给了她一个想赢过的练习对象。" },
    dae = { name = "营地守位人", description = "她替临时营地看过门、占过座，一顶帽子便能留住打水同伴的位置。嘎嘎冲喊得响，回头点人也一样响。自己的窝守住了，出门的伙伴才能放心回来。" },
    manyuemei = { name = "红线督战员", description = "她替演练队排过站位，一截红线把先后和左右都划得明白。轻弩拿得稳，提醒说得短。别人指出漏看的一处，她会当场改线，再把新位置讲一遍。" },
    xiaohani = { name = "随行藏粮人", description = "她带几只小布袋沿商路护送，干粮、针线和路费各有结绳。仓鼠的外号听久了，她也不急着反驳。藏够下一程的东西以后，还想给自己攒一处愿意留下的屋檐。" },
    keke = { name = "结伴守望者", description = "她在商旅落脚处帮人认朋友、腾座位，赶路时也留意侧后的同伴。“自己人”说得亲热，真要帮忙，她却会先把人认清，再问这一回需要什么。" },
    yuxiang = { name = "轮值长枪卫", description = "她守过长夜的门岗，长矛立得稳，替班来没来记得更清。“五老压阵”让旁人安心，她自己先查轮值表。下一班有人按时到场，才是最合用的夸奖。" },
    tongzhu = { name = "木熊游戏主持", description = "她带木熊主持过桌边游戏，越是互不服气的人聚齐，越有兴致敲杯开局。规则刻在熊底，笑声落在桌上。输了想改上一手，她会把木熊转过去，请人再读一遍。" },
    meiya = { name = "巡演领舞", description = "宴厅和临时舞台上，她都领过大王舞。节拍要齐，脚下要稳，主角转身时旁人也得有地方站。热闹散后，她习惯最后看一遍场子，把被忙乱落下的人叫过来。" },
    wanshe = { name = "蛇步试招客", description = "她走过各处练武场，招式先起大名，再在木桩前一遍遍验脚步。“秦国的神”挂在门前很醒目，门内的蛇形痕迹却有深有浅，记着改过的每一招。" },
    tutu = { name = "行旅歌者", description = "她带曲子和路票走过不少营火，唱完有时启程，有时再坐一晚。下一站已有打算，沿途也还会遇见值得停步的人。同行的路，她愿意一段一段说定。" },
    naigai = { name = "街头论武客", description = "她在练武场边讲过许多必胜办法，第一下真落到盾上，常把讲解震回肚里。嘴强王者退到盾后还要补两句。旁人笑完再喊一轮，她也还肯重新举盾。" },
    xiaojie = { name = "车锁看守", description = "她替货车和仓门管过钥匙，锁扣和交接都要亲手查。备用钥匙挂着小牌，借走工具的人得留名字。熟人尤其别急，一句“认识”还没她手里的借据结实。" },
    bula = { name = "钱袋戏法师", description = "她在小舞台上变过钱袋戏法，散场后逐枚清点真正的收入。掌声值几声叫好，布料和饭钱却得付实钱。采购时，她还习惯请用东西的人先试一试。" },
    suwa = { name = "踩点斥候", description = "她替旅队探过转角和路口，习惯早出半步，摸清别人还没走到的地方。急刹的记号准，近路也熟；只是在前面跑得太快时，还得回头补一遍路标。" },
    qianhan = { name = "坡道跑手", description = "她在短坡赛和跑腿差事之间练脚力，把长路拆成几次呼吸。003号木牌总擦得很亮，练习簿却照实留着空格。夸奖听完，她便去跑下一段。" },
    wangdazhi = { name = "搭台护场人", description = "她替流动剧班撑过幕布、顶过架脚，场面一乱便有人喊芷芷。袖里那张节目纸折得很整齐，上面也有她自己的名字。救场的本事练熟了，登场的时辰仍想争回来。" },
    yaoyaoya = { name = "演武破阵手", description = "她在公开演武中挥过长柄兵器，围观者一声声喊奶团吕布。挑战书收了不少，她仍先看自己答应的差事。眼前这一击怎么出，身后哪面旗会跟上，她都想看清。" },
    yangmiemie = { name = "铃车快递员", description = "她推挂铃的小车送过包裹，绳结松动和轮轴发颤都听得出来。直路愿意追，弯前肯留力。回执签下以前，还要把封口和货物再查一遍。" },
    songnuanyang = { name = "鹌鹑记事员", description = "她在集市替人记行程、写见闻，鹌鹑纹兜帽常被响动吓得缩一下。纸上有赢的那天，也有没赢的那天。遇见没问完的问题，她会探头再追一句。" },
    xiaogui = { name = "背壳小将", description = "大脑袋塞不进普通头盔，背壳倒先把气势撑足。她叫阿飞飞爹，自己的战绩牌也擦得认真，等着亲手添一场胜负。壳上旧纹像沉在水底的星，擦过便收起，很少向人讲。" },
};
