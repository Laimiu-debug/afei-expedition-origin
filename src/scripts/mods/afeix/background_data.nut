// Generated by tools/build_backgrounds.py from data/character-backgrounds.json.
::AfeixExpedition.CharacterBackgrounds <- {
    afei = { name = "黑旗发起人", description = "他替自己的招募旗写下“嘉豪”，却连举稳盾牌都还费劲。凭一张敢开口的嘴和几位愿意帮忙的伙伴，他把临时搭伙喊成了远征团。现在，旗底的每一个名字都在等他把话兑现。" },
    damou = { name = "游历盾师", description = "他在练武场与护送队之间讨过生活，走到哪里都想向高手借一招，顺便请人换面旗。遇见还站不稳的阿飞后，他把自己的盾放在最前面，嘴上嫌弃，脚下没有先走。" },
    mocha = { name = "随军账房", description = "他替短途队伍记过粮钱与欠账，一把旧算盘比漂亮保证更有说服力。黑旗的三位队长里，他把别人的豪言拆成一天一天能付清的开销，也得学着把自己的担当写进账里。" },
    bottle = { name = "球场突击手", description = "她在集镇球场练出看缺口与接来球的本领，喜欢突破，也记得是谁肯把球交到自己手里。“蛤妈”是伙伴叫出来的亲近，属于她自己的胜负心却从未交给别人保管。" },
    shuaizi = { name = "营门鼓手", description = "她替临时营地敲集合鼓、记出入的人，四声鼓点比喊话更让她安心。响动仍会吓她一跳，但等人真的要撤回来，她总能想起哪条路还得留着。" },
    lili = { name = "巡演射手", description = "她随流动演出展示箭术，知道什么时候站到灯下，什么时候换个位置让观众重新找她。高背椅和“超巨”的称呼是排场，能不能再赢一轮，仍得看她亲手射出的箭。" },
    xiaoyueya = { name = "杂货改造匠", description = "她守过一张什么都能摆的杂货桌，断木条、旧扣子与卖不出去的零件都舍不得扔。东西到了她手里总能换一种用途，只是伙伴有时得先问清这回试验要花多少钱。" },
    yuchujiu = { name = "巡队哨手", description = "她跟着行路队伍盯过岔路和队尾，记人头比记战利品熟。提醒常喊得像吵架，可越是自己人，她越不肯让一句“差不多”混过去。" },
    xiaoyubeike = { name = "栈桥护卫", description = "栈桥拥挤、货队进退不得时，她习惯先举盾把空位顶住，再说剩下的事。“唯一的男人”被她当作担当的玩笑，硬撑借来的那口气却总要有人接班才能还。" },
    wangduidui = { name = "口信核验员", description = "她替集镇核对过集合口信，最常问的是去哪里、做什么、谁接应。别人拿歪王冠喊她“太子”，她却把那三个问题刻在牌子背面，准备继续问到团长把话讲清。" },
    laocai = { name = "护队参谋", description = "他受雇替行路队伍摆地图、排接应，桌上的木旗总会给坏消息留一格。最难说服他的从来不是冒险，而是计划里人人有位置，出了问题却找不到谁负责。" },
    yanzi = { name = "营地调解人", description = "他曾在几支佣兵队之间转交口信、核对交接。争执时擅长先让人放下棍子，却不肯用笑话抹掉少了的货和没说完的话。旁人渐渐习惯把难事都递给他，如今他也开始把自己的时辰和应得的那份写进清单。" },
    tiantong = { name = "蓝旗信使", description = "她背过驿站的蓝旗信袋，封口检查了还要看回执是谁签的。大家叫她“小虎”，她更在意别人别把跑得快和真正送到混为一谈。" },
    xiaoning = { name = "怪图向导", description = "她靠替旅人画路图挣过盘缠，只是图上的河像面饼，漏掉的一角常得由本人补讲。别人喊她“外星人”，她想入神时顾不上擦嘴角；偶尔绕错，偶尔也真能发现没人想到的路。" },
    xiaopangxu = { name = "街头舞者", description = "她在街边空地跟着鼓点练卡拍与转身，倒下的桶也能接成下一拍。把盾举起来后，重心又得重新找；阿飞的嘉豪步伐正好给了她一个不肯认输的练习对象。" },
    dae = { name = "营地守位人", description = "她替临时营地看过门口和座位，一顶帽子就足够替去打水的同伴占住凳子。她敢喊敢冲，真正放不下的却是那块约好让自己人回来的地方。" },
    manyuemei = { name = "红线督战员", description = "她替演练队排过位置，红线一拉，谁站哪边、谁先说话就要讲清楚。轻弩与短句是她维持秩序的办法，被指出漏看一处时，她也愿意当场改线。" },
    xiaohani = { name = "随行藏粮人", description = "她带着几只小布袋沿商路做护送，挣来的钱、够用的干粮和舍不得丢的扣子各有去处。别人笑称仓鼠，她先护好自己那份，再考虑愿意分出多少。储备是上路的底气，她还在寻找自己愿意留下的屋檐。" },
    keke = { name = "结伴守望者", description = "她在往来商旅的落脚处帮人认朋友、腾位置，也习惯看一眼落在侧后的同伴。“自己人”从来不是随口的招呼，但她也不想让这三个字变成什么都由她兜着的理由。" },
    yuxiang = { name = "轮值长枪卫", description = "她守过长时间的门岗，长矛立得稳，交班的人来没来却记得更清楚。“五老压阵”听起来很有分量，她最想追问的仍是下一班到底谁到场。" },
    tongzhu = { name = "木熊游戏主持", description = "她带着一只木熊主持过桌边游戏，越是几位互不服气的人坐在一起，她越有兴致。她喜欢让人猜错后的热闹，但不允许输家悄悄改掉已经发生的那一步。" },
    meiya = { name = "巡演领舞", description = "她在宴厅与临时舞台领过舞，记得每一拍，也记得哪块板会绊脚。“大王舞”要把主角托起来，她却知道再响的名号也得在该让路时让出位置。" },
    wanshe = { name = "蛇步试招客", description = "她走过各处练武场，给招式起大名字，再用木桩上的蛇形痕迹一遍遍验脚步。“秦国的神”是醒目的招牌，她仍愿意为了一个站不稳的细节和别人争到天黑。" },
    tutu = { name = "行旅歌者", description = "她带着曲子和下一站的打算走过不少营火，唱完有时就走，有时又多听完一个笑话。她愿意同行，也要保有说明自己为何留下、何时告别的自由。" },
    naigai = { name = "街头论武客", description = "她在练武场边讲过许多必胜的办法，真拿起盾时却常被第一下震得退回去。躲在盾后仍要解释两句的嘴强王者，至少每次丢完脸还肯把盾捡回来。" },
    xiaojie = { name = "车锁看守", description = "她替货车与仓门管过钥匙，听到“大家都认识”反而会再检查一遍锁。备用钥匙放在哪里，她记得比任何口头保证都清楚；信任也得有人把交接做完。" },
    bula = { name = "钱袋戏法师", description = "她能在小舞台上让钱袋看起来凭空鼓起，散场后却会把里面到底剩多少数得分明。她既懂吸引目光，也懂预算最后要落到真正使用物资的人手上。" },
    suwa = { name = "踩点斥候", description = "她替旅队探过路口与转角，习惯早出半步，先看清别人还没走到的地方。她画在地上的急刹记号很准确，难的是让后面的人也看懂这一条路。" },
    qianhan = { name = "坡道跑手", description = "她在短坡赛与跑腿差事之间攒经验，把一条长路拆成几次呼吸，003 号木牌擦得比谁都认真。别人把她夸成传奇，她会先纠正，再去把眼前这一段跑完。" },
    wangdazhi = { name = "搭台护场人", description = "她给流动演出撑过幕布、顶过架脚，场面一乱，大家总先喊“芷芷”。写着自己名字的节目纸被折得很整齐，她记得救过多少次场，也记得自己的登场还排在后面。" },
    yaoyaoya = { name = "演武破阵手", description = "她拿长柄兵器打过公开演武，围观者喊“奶团吕布”，留下来的报名纸却常把单挑写得比别的事都大。她喜欢赢，也想决定这一击究竟替谁打开道路。" },
    yangmiemie = { name = "铃车快递员", description = "她推着挂小铃的轻车送过包裹，听一声颤响就知道哪边绳结松了。直路上愿意追，到了弯前却肯留力；送得快值得夸，完整交到人手里才算做完。" },
    songnuanyang = { name = "鹌鹑记事员", description = "她在集市替人记过行程与见闻，带着鹌鹑纹兜帽，响声一大先缩一下，再探头把问题问完。她的纸上留着许多没有赢的那一天，也不肯替别人补一个虚假的漂亮结尾。" },
    xiaogui = { name = "背壳小将", description = "他顶着难塞进头盔的大脑袋，背壳先把气势撑足，写着自己名字的小牌却还在等一场像样的战绩。叫阿飞“飞爹”很亲近，他更想亲手把证明摆到飞爹面前。 壳上几道旧纹像沉在水底的星，他很少提起。" },
};
