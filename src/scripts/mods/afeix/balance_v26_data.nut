t.strong",["path"]="scripts/skills/traits/strong_trait",["delta"]=[0,10,0,0,0,0,0,0],["excluded"]=["tiny","fragile","fat","ailing"]},["sure_footing"]={["id"]="trait.sure_footing",["path"]="scripts/skills/traits/sure_footing_trait",["delta"]=[0,0,0,0,0,0,5,0],["excluded"]=["clumsy","insecure"]},["survivor"]={["id"]="trait.survivor",["path"]="scripts/skills/traits/survivor_trait",["delta"]=[0,0,0,0,0,0,0,0],["excluded"]=["bleeder","pessimist","deathwish","ailing"]},["swift"]={["id"]="trait.swift",["path"]="scripts/skills/traits/swift_trait",["delta"]=[0,0,0,0,0,0,0,5],["excluded"]=["clumsy","fat","clubfooted"]},["teamplayer"]={["id"]="trait.teamplayer",["path"]="scripts/skills/traits/teamplayer_trait",["delta"]=[0,0,0,0,0,0,0,0],["excluded"]=["cocky","bloodthirsty","drunkard","dumb","impatient"]},["tough"]={["id"]="trait.tough",["path"]="scripts/skills/traits/tough_trait",["delta"]=[10,0,0,0,0,0,0,0],["excluded"]=["tiny","fragile","bleeder","ailing"]},["gluttonous"]={["id"]="trait.gluttonous",["path"]="scripts/skills/traits/gluttonous_trait",["delta"]=[0,0,0,0,0,0,0,0],["excluded"]=["athletic","iron_lungs","spartan","fragile"]},["huge"]={["id"]="trait.huge",["path"]="scripts/skills/traits/huge_trait",["delta"]=[0,0,0,0,0,0,-5,-5],["excluded"]=["tiny","quick","fragile"]},["quick"]={["id"]="trait.quick",["path"]="scripts/skills/traits/quick_trait",["delta"]=[0,0,0,10,0,0,0,0],["excluded"]=["huge","hesitant","clubfooted"]}},["skills"]={["borrow_strike"]={["text"]="持盾与一名相邻可行动队员互护，双方近防+5，至各自下次回合开始。临时护卫近防取最高，不相加。",["shield"]=true,["fatigue"]=12,["target"]="ally",["ap"]=3,["name"]="大哥借我",["cd"]=3,["range"]=1,["active"]=true,["uses_per_battle"]=null,["key"]="borrow_strike",["owner"]="damou",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["together_lift"]={["name"]="一起抬",["text"]="持盾且2格内至少两名其他可行动队员：自身决心+8、近战破甲+10%。队友离开立即失效，不按人数叠乘。",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=2,["uses_per_battle"]=null,["key"]="together_lift",["owner"]="damou",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["steal_bro"]={["owner"]="damou",["icon"]="steal_bro",["name"]="偷大哥",["text"]="本人在册且存活时，已解锁主题人物的服务费八折，最多省200克朗，每7日一次。装备与补级费不打折；仅成功雇佣消费机会；不能改变解锁与候选冷却。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="steal_bro",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["scrap_parts"]={["owner"]="mocha",["icon"]="scrap_parts",["name"]="地精出身",["text"]="本人在册且存活时，原版维修每实际消耗7工具返1，每日最多3。只记录外部维修支出，返还不再作为消耗；不按预备队人数复制。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="scrap_parts",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["abacus_mark"]={["mode"]="mark",["icon"]="abacus_mark",["text"]="标记一个可见敌人，下一次己方单体武器攻击命中+10，尝试后耗尽，两次施术者回合开始后到期。一人仅一个标记；与全部Mod命中加成合计≤10。",["range"]=4,["shield"]=false,["target"]="enemy",["owner"]="mocha",["fatigue"]=8,["ap"]=2,["name"]="地精算盘",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="abacus_mark",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=7,["v1_text"]="标记一个可见敌人，下一次己方单体武器攻击命中+10，尝试后耗尽，两次施术者回合开始后到期。一人仅一个标记；与全部Mod命中加成合计≤10。",["v1_ap"]=3,["v1_fatigue"]=12,["v1_cd"]=2},["shadow_captain"]={["mode"]="buff",["icon"]="shadow_captain",["text"]="一名其他队员的下一次单体武器攻击少耗8疲劳，两次目标回合结束后到期；最低仍耗原消耗的50%向上取整。减耗取最高，优惠不返还AP。",["range"]=3,["shield"]=false,["target"]="ally",["owner"]="mocha",["fatigue"]=8,["ap"]=2,["name"]="幕后队长",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="shadow_captain",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=7,["v1_text"]="一名其他队员的下一次单体武器攻击少耗8疲劳，两次目标回合结束后到期；最低仍耗原消耗的50%向上取整。减耗取最高，优惠不返还AP。",["v1_ap"]=3,["v1_fatigue"]=12,["v1_cd"]=2},["bottle_breakthrough"]={["text"]="以单手近战武器的普通单体招式攻击，命中 +10；攻击后近战防御 -5，直到自己下次回合开始。命中或落空都会进入冷却。",["shield"]=false,["fatigue"]=18,["target"]="weapon",["ap"]=4,["name"]="瓶队突破",["cd"]=2,["range"]=1,["active"]=true,["uses_per_battle"]=null,["key"]="bottle_breakthrough",["owner"]="bottle",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=16},["finals_moment"]={["name"]="决赛时刻",["text"]="从第 5 轮起，近战武器攻击伤害 +10%，每次近战武器技能额外消耗 3 疲劳。",["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="finals_moment",["owner"]="bottle",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["teammate_ball"]={["owner"]="bottle",["icon"]="teammate_ball",["name"]="队友给的球",["text"]="每轮首次攻击本轮已被其他队员单体武器命中的敌人时，命中 +5；尝试后消耗，不适用于范围攻击。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="teammate_ball",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["drum"]={["mode"]="team",["icon"]="drum",["text"]="指定自己或2格内队员为中心，选择最多3名2格内可行动己方角色（可含自身）：下次回合开始恢复6疲劳，决心+5至该回合结束。禁止扩大到12人，援军不追补。",["range"]=2,["shield"]=false,["target"]="self",["owner"]="shuaizi",["fatigue"]=20,["ap"]=4,["name"]="打鼓",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="drum",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=17},["small_heart"]={["owner"]="shuaizi",["icon"]="small_heart",["name"]="小心脏",["text"]="2 格内没有可行动队员时决心 -8；持盾且与队员相邻时，被攻击时近防 +4。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="small_heart",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["guard_gate"]={["mode"]="buff",["icon"]="guard_gate",["text"]="必须持盾，近防+6、免疫推拉，到自己下次回合开始；禁止主动移动。眩晕、网缚、伤害照常；失盾或被强制移动立即终止。",["range"]=0,["shield"]=true,["target"]="self",["owner"]="shuaizi",["fatigue"]=12,["ap"]=3,["name"]="守门",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="guard_gate",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["unselectable"]={["mode"]="buff",["icon"]="unselectable",["text"]="无相邻敌人才可用：自身远防+20，至下次回合开始。主动攻击或移动即解除。敌人仍能选中且范围攻击照常。每战最多2次。",["range"]=0,["shield"]=false,["target"]="self",["owner"]="lili",["fatigue"]=16,["ap"]=3,["name"]="无法选中",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="unselectable",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=14},["chaoju"]={["owner"]="lili",["icon"]="chaoju",["name"]="超巨",["text"]="单体远程武器每轮首次命中+1聚光、首次落空-1，最多2层；每层远攻+3、决心+3。战后清零，计入Mod命中+10总上限。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="chaoju",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["ouqi"]={["owner"]="lili",["icon"]="ouqi",["name"]="欧气",["text"]="士气检定失败时获得至少25%的原版重掷机会，与其他重掷来源取高。不重掷命中、伤害、招募或掉落；不是免疫恐惧。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="ouqi",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["supermarket"]={["owner"]="xiaoyueya",["icon"]="supermarket",["name"]="超市里",["text"]="本人在册存活时，每日首笔城镇食物购买优惠15%，最多省30克朗；取消/失败不消耗。不能靠拆单多次获得，出售无加成。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="supermarket",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["biantai"]={["owner"]="xiaoyueya",["icon"]="biantai",["name"]="变态",["text"]="单体远程武器切换到与上次不同的敌人时命中+6，每轮一次。首次射击不触发；落空也更新目标。计入全Mod+10总上限。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="biantai",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["optimist"]={["owner"]="xiaoyueya",["icon"]="optimist",["name"]="乐天派",["text"]="每战一次，自己回合开始时若处于动摇/崩溃，恢复一级士气并消除4疲劳。不能解除逃跑、魅惑、眩晕；不升到自信。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=1,["key"]="optimist",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["dog_bark"]={["text"]="干扰 3 格内可见的人类或绿皮，使其近战命中 -8，直到目标下次回合结束。不影响亡灵、野兽及免疫恐惧的敌人。同名效果不叠加。",["shield"]=false,["fatigue"]=12,["target"]="enemy",["ap"]=3,["name"]="狗叫",["cd"]=2,["range"]=3,["active"]=true,["uses_per_battle"]=null,["key"]="dog_bark",["owner"]="yuchujiu",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["loyalty"]={["name"]="忠诚",["text"]="与可行动的阿飞相距不超过 2 格时，决心 +10。阿飞未出战或失去行动能力时，依次由王大谋、午夜抹抹茶代任。",["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="loyalty",["owner"]="yuchujiu",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["guard_swap"]={["mode"]="swap",["icon"]="guard_swap",["text"]="与相邻同高、可行动己方队员交换位置，免脱离攻击；双方都不能处于网缚、眩晕、不可移动或换位免疫。每战最多2次，移动本身不赠送攻击。",["range"]=1,["shield"]=false,["target"]="ally",["owner"]="yuchujiu",["fatigue"]=20,["ap"]=3,["name"]="护团换位",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="guard_swap",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=17},["nicotine"]={["text"]="每战一次，立即消除 15 点累积疲劳；随后两次自己回合开始时，疲劳恢复量各减少 5。疲劳为零时不能使用。此技能不回复生命。",["shield"]=false,["fatigue"]=0,["target"]="self",["ap"]=2,["name"]="尼古丁",["cd"]=0,["range"]=0,["active"]=true,["uses_per_battle"]=1,["key"]="nicotine",["owner"]="xiaoyubeike",["mastery"]="11级：尼古丁当场恢复18，透支仍为两次各5",["mastery_fatigue"]=0},["only_man"]={["name"]="唯一的男人",["text"]="至少一名未持盾的可行动己方队员与自己相邻时，受攻击时近防+5。人数不叠加；与其他Mod常驻条件近防共享+6上限。",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=1,["uses_per_battle"]=null,["key"]="only_man",["owner"]="xiaoyubeike",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["cover_up"]={["mode"]="cover",["icon"]="cover_up",["text"]="持盾守原位，直到自己下次回合开始。下一次针对相邻队员的敌方单体近战，若原攻击者也可合法攻击自己，则改由自己承受且总武器伤害×0.85；落空也消耗。每战最多2次。",["range"]=1,["shield"]=true,["target"]="ally",["owner"]="xiaoyubeike",["fatigue"]=18,["ap"]=4,["name"]="顶上去",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="cover_up",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=16},["prince_order"]={["mode"]="team",["icon"]="prince_order",["text"]="阿飞未出战或不能行动时，选择2格内最多3名己方角色（含自己），近防+4、决心+8至受益者下次回合结束。每战最多2次；阿飞恢复后不能再发动。",["range"]=2,["shield"]=false,["target"]="self",["owner"]="wangduidui",["fatigue"]=20,["ap"]=4,["name"]="太子发令",["cd"]=4,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="prince_order",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=17},["fear_afei"]={["owner"]="wangduidui",["icon"]="fear_afei",["name"]="恐飞派",["text"]="每战首次在3格内看到阿飞施放豪气冲天/飞爹在此，自己恢复8疲劳、下一次单体武器命中-5。若本战阿飞未上场，则在首次自身回合开始的基础恢复结算后、剩余疲劳仍至少4时恢复4；本战仅一次，两种触发互斥。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=3,["uses_per_battle"]=null,["key"]="fear_afei",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0,["v1_text"]="每战首次在3格内看到阿飞施放豪气冲天/飞爹在此，自己恢复8疲劳、下一次单体武器命中-5。若本战阿飞未上场，则第一回合开始改为恢复4疲劳；不能同时领两份。",["v1_ap"]=0,["v1_fatigue"]=0,["v1_cd"]=0},["dui_sentence"]={["mode"]="buff",["icon"]="dui_sentence",["text"]="一名其他队员近防+4、决心+6至其下次回合结束。临时近防取高。此分支不再承诺清除互斥分支“恐飞派”的自身惩罚。",["range"]=3,["shield"]=false,["target"]="ally",["owner"]="wangduidui",["fatigue"]=10,["ap"]=2,["name"]="怼一句",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="dui_sentence",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=9,["v1_text"]="一名其他队员近防+4、决心+6至其下次回合结束，同时清除自身恐飞派命中惩罚。临时近防取高。",["v1_ap"]=3,["v1_fatigue"]=12,["v1_cd"]=2},["steady_hand"]={["text"]="必须持盾，对自己和最多两名相邻可行动队员：近防+6、决心+6，至各自下次回合开始。选择后固定受益者，临时护卫近防取高。",["shield"]=true,["fatigue"]=18,["target"]="self",["ap"]=4,["name"]="稳一手",["cd"]=3,["range"]=1,["active"]=true,["uses_per_battle"]=null,["key"]="steady_hand",["owner"]="laocai",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=16},["blue_form"]={["name"]="蓝旗布阵",["text"]="战斗第一轮开始时，自己与最多两名相邻可行动队员先攻+12；自己前两轮决心+5。第一轮先攻只作用一次，增援不补发。",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=1,["uses_per_battle"]=null,["key"]="blue_form",["owner"]="laocai",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["good_card"]={["owner"]="laocai",["icon"]="good_card",["name"]="一张好牌",["text"]="某敌人本轮被两名不同队员的单体武器命中后，自己下一次单体近战攻击它时命中+8，每轮一次，尝试即消耗。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="good_card",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["yanzi_watch"]={["key"]="yanzi_watch",["name"]="看准再出手",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["text"]="本次行动尚未移动时，首次单体近战命中+5；尝试消耗，计入Mod命中+10总上限。无额外射程。",["uses_per_battle"]=null,["owner"]="yanzi",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0,["extended"]=true,["growth"]=false,["mode"]="buff",["once"]=false,["shield"]=false,["target"]="self"},["yanzi_cover"]={["key"]="yanzi_cover",["name"]="侧身接线",["active"]=true,["ap"]=3,["fatigue"]=14,["cd"]=2,["range"]=1,["text"]="必须持盾，为自己与一名相邻可行动队员提供远防+8，至各自下次回合开始；失盾立即结束。临时远防取最高，不获得近防。",["uses_per_battle"]=null,["owner"]="yanzi",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=12,["extended"]=true,["growth"]=false,["mode"]="buff",["once"]=false,["shield"]=true,["target"]="ally"},["yanzi_reply"]={["key"]="yanzi_reply",["name"]="留一手",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["text"]="每轮首次躲过敌方单体近战攻击后，本次或下一次自己行动的第一次单体近战命中+6，最迟下次回合结束清除。不会触发免费反击。",["uses_per_battle"]=null,["owner"]="yanzi",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0,["extended"]=true,["growth"]=true,["mode"]="buff",["once"]=false,["shield"]=false,["target"]="self"},["catch_rear"]={["mode"]="buff",["icon"]="catch_rear",["text"]="一名其他队员远防+10，下一次回合开始额外恢复4疲劳，至该回合结束。没有额外射击，不消耗弹药。",["range"]=3,["shield"]=false,["target"]="ally",["owner"]="tiantong",["fatigue"]=12,["ap"]=3,["name"]="接住后排",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="catch_rear",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["return_arrow"]={["owner"]="tiantong",["icon"]="return_arrow",["name"]="回头箭",["text"]="本次行动实际普通移动至少一格后，首次单体远程命中+5，每轮一次；专属位移、换位不计。付移动AP后能否开弓须按原武器核算。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="return_arrow",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["scout_path"]={["owner"]="tiantong",["icon"]="scout_path",["name"]="探路",["text"]="自身视野+1、前两轮先攻+10；不生成世界地图路线，不增加弹药、射程或夜视。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="scout_path",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["drool"]={["mode"]="buff",["icon"]="bear_strike",["text"]="3格内可见人类/绿皮先攻-20、远攻-8至目标下次回合结束。免疫恐惧者、亡灵、野兽无效；同名取高，不能降低AP。",["range"]=3,["shield"]=false,["target"]="enemy",["owner"]="xiaoning",["fatigue"]=12,["ap"]=3,["name"]="流口水",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="drool",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["alien_eye"]={["owner"]="xiaoning",["icon"]="abacus_mark",["name"]="外星人的观察",["text"]="本次行动尚未移动时单体远程命中+5，普通/技能/强制移动均使本次行动失效。与其他Mod命中加成合计≤10。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="alien_eye",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["signal_delay"]={["owner"]="xiaoning",["icon"]="return_arrow",["name"]="信号延迟",["text"]="每轮首次单体远程落空后，下次单体远程命中+8，尝试后消耗，最迟下轮结束清零；不允许反复故意射空累积。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="signal_delay",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["pang_share"]={["mode"]="buff",["icon"]="borrow_strike",["text"]="持盾给一名相邻队员近防+4、决心+4，至其下次回合结束；失盾或断开相邻立即结束。11级仅减少疲劳，不再额外把近防叠到+6。",["range"]=1,["shield"]=false,["target"]="ally",["owner"]="xiaopangxu",["fatigue"]=12,["ap"]=3,["name"]="借你半面盾",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="pang_share",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["pang_anchor"]={["owner"]="xiaopangxu",["icon"]="hold_ground",["name"]="踩稳节拍",["text"]="按稳街舞的步点：持盾且与可行动队员相邻时，被攻击时近防 +4。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="pang_anchor",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["pang_breath"]={["owner"]="xiaopangxu",["icon"]="breathe_easy",["name"]="挨过这一拍",["text"]="每轮首次受到敌方直接武器攻击并存活后恢复3疲劳；零伤害命中也算一次，闪避与持续伤害不触发。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="pang_breath",["mastery"]="11级：每轮首次受敌方直接武器命中并存活后，恢复由3增至4；不再额外恢复自身1疲劳。仍受每人每轮Mod额外恢复上限8约束。",["mastery_fatigue"]=0,["specialized_mastery"]=true},["guard_nest"]={["text"]="持盾守原位，自己与最多两名相邻队员远防+8，至大鹅下次回合开始。大鹅移动/失盾/无法行动，或队友不再相邻时失效。",["shield"]=true,["fatigue"]=14,["target"]="self",["ap"]=3,["name"]="守窝",["cd"]=2,["range"]=1,["active"]=true,["uses_per_battle"]=null,["key"]="guard_nest",["owner"]="dae",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=12},["goose_bully"]={["name"]="鹅势欺人",["text"]="至少与一名敌人相邻，且相邻的其他可行动队员数不少于相邻敌人数时，决心 +5、近战武器命中 +5。",["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="goose_bully",["owner"]="dae",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["gaga_charge"]={["mode"]="weapon",["icon"]="gaga_charge",["text"]="单手近战普通单体招式，命中-5、护甲伤害×1.30；不移动不击退、不额外攻击。血伤不提高，伤害沿用所持武器，不能模拟双手技能。",["range"]=1,["shield"]=false,["target"]="weapon",["owner"]="dae",["fatigue"]=16,["ap"]=4,["name"]="嘎嘎冲",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="gaga_charge",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=14,["v1_text"]="单手近战普通单体招式，命中-5、护甲伤害×1.20；不移动不击退、不额外攻击。伤害沿用所持武器，不能模拟双手技能。",["v1_ap"]=4,["v1_fatigue"]=20,["v1_cd"]=2},["berry_mark"]={["mode"]="mark",["icon"]="abacus_mark",["text"]="标记一个4格内可见敌人，下一次己方单体远程命中+8，尝试消耗，最多持续两轮；每战3次，每位施术者只保留一个。命中加成总上限+10，95%封顶仍有效。",["range"]=4,["shield"]=false,["target"]="enemy",["owner"]="manyuemei",["fatigue"]=8,["ap"]=1,["name"]="红线记号",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=3,["key"]="berry_mark",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=7,["v1_text"]="标记一个4格内可见敌人，下一次己方单体远程命中+8，尝试消耗，最多持续两轮；每位施术者只保留一个，命中加成总上限+10。",["v1_ap"]=2,["v1_fatigue"]=10,["v1_cd"]=2},["berry_eye"]={["owner"]="manyuemei",["icon"]="snake_read",["name"]="看清缝隙",["text"]="攻击与己方队员相邻的敌人时，每轮首次单体远程命中 +5。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="berry_eye",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["berry_reserve"]={["owner"]="manyuemei",["icon"]="no_last_throw",["name"]="留一支给后面",["text"]="每轮首次单体远程命中与队员相邻的敌人后恢复3疲劳；一次攻击只结算一次，不按受击目标数倍增。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="berry_reserve",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["gentle_note"]={["mode"]="buff",["icon"]="catch_baton",["text"]="一名其他队员近防+3、决心+8至其下次回合结束。与其他护卫临时近防取高；不治疗不复活。",["range"]=2,["shield"]=false,["target"]="ally",["owner"]="xiaohani",["fatigue"]=12,["ap"]=3,["name"]="轻声提醒",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="gentle_note",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["companion"]={["owner"]="xiaohani",["icon"]="loyalty",["name"]="有人同行",["text"]="与可行动队员相距≤2格时，自己决心+6、先攻+5。没有人数加成，不对队友传播。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=2,["uses_per_battle"]=null,["key"]="companion",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["spare_breath"]={["owner"]="xiaohani",["icon"]="segment_breath",["name"]="留口气",["text"]="本次行动没有使用主动技能且没有相邻敌人，回合结束恢复6疲劳，每轮一次。不可同时获得主动攻击收益。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["uses_per_battle"]=null,["key"]="spare_breath",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["pokemon"]={["text"]="持盾保护一名相邻队员：近防+4、远防+8至其下次回合结束；可可须保持可行动、持盾且相邻。护卫近防取高。",["shield"]=true,["fatigue"]=12,["target"]="ally",["ap"]=3,["name"]="保可梦",["cd"]=2,["range"]=1,["active"]=true,["uses_per_battle"]=null,["key"]="pokemon",["owner"]="keke",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["breathe_easy"]={["name"]="松口气",["text"]="可可持盾，相邻队员躲过敌方单体武器攻击后，可可恢复4疲劳。每轮一次、每战最多20；队友越多不增加上限。",["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=1,["uses_per_battle"]=null,["key"]="breathe_easy",["owner"]="keke",["mastery"]="11级：相邻队员躲过敌方单体武器攻击后恢复由4增至5；不再额外恢复自身1疲劳。仍每轮一次、每战累计最多20、恢复上限8。",["mastery_fatigue"]=0,["specialized_mastery"]=true},["own_people"]={["owner"]="keke",["icon"]="own_people",["name"]="自己人",["text"]="持盾保护自己人：与至少一名生命不超过一半的可行动队员相邻时，被攻击时近防 +4、决心 +6。现版不提供远程误伤减免。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="own_people",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["long_watch"]={["mode"]="buff",["icon"]="long_watch",["text"]="至自己下次回合开始，近防/远防+8、先攻-10；期间首次受到敌方直接武器伤害恢复4疲劳。无相邻敌人时也可用，不产生额外回合。",["range"]=0,["shield"]=false,["target"]="self",["owner"]="yuxiang",["fatigue"]=16,["ap"]=3,["name"]="长轮守门",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="long_watch",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=14},["five_elder"]={["owner"]="yuxiang",["icon"]="five_elder",["name"]="五老压阵",["text"]="与至少两名可行动队员相邻时，被攻击时近防 +4，决心 +6。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="five_elder",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["shift_arrive"]={["owner"]="yuxiang",["icon"]="shift_arrive",["name"]="替班到了",["text"]="自己回合开始时若出现一名此前回合开始时不相邻的可行动队员，恢复4疲劳；首轮只记录。每轮一次，每战最多16，重复来回不突破上限。",["extended"]=true,["active"]=false,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=1,["uses_per_battle"]=null,["key"]="shift_arrive",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["bear_strike"]={["mode"]="buff",["limit"]=2,["target"]="enemy",["cd"]=2,["icon"]="bear_strike",["text"]="3格内人类/绿皮下一次单体武器命中-10，尝试消耗，至第二次目标回合结束到期。每战2次；免疫恐惧者不受影响。",["shield"]=false,["owner"]="tongzhu",["fatigue"]=12,["range"]=3,["name"]="小熊出击",["ap"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="bear_strike",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=11},["know_rules"]={["owner"]="tongzhu",["icon"]="know_rules",["name"]="先懂规则",["text"]="4 格内可见敌人连续两次使用同一武器技能时，获得一层看懂，每层使自身近战命中 +3；最多两层，每轮最多一层，战后清零。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"]=0,["fatigue"]=0,["cd"]=0,["range"]=0,["key"]="know_rules",["mastery"]="11级：自身每回合额外恢复1疲劳，纳入全Mod额外恢复上限",["mastery_fatigue"]=0},["cup_signal"]={["mode"]="team",["icon"]="cup_signal",["text"]="选择2格内最多3名己方队员（含自己），各下一次单体武器少耗4疲劳，两次目标回合结束后到期；最低仍耗原消耗50%向上取整，同类优惠取高。",["range"]=2,["shield"]=false,["target"]="self",["owner"]="tongzhu",["fatigue"]=10,["ap"]=3,["name"]="敲杯为号",["cd"]=3,["extended"]=true,["active"]=true,["uses_per_battle"]=null,["key"]="cup_signal",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=9,["v1_text"]="选择2格内最多3名己方队员（含自己），各下一次单体武器少耗4疲劳，两次目标回合结束后到期；最低仍耗原消耗50%向上取整，同类优惠取高。",["v1_ap"]=4,["v1_fatigue"]=18,["v1_cd"]=3},["king_dance"]={["mode"]="step",["icon"]="king_dance",["text"]="移到相邻同高可通行空格，免脱离攻击；落点最多两名相邻队员先攻+10至各自下次回合结束。定身不能用，每战2次。",["range"]=1,["shield"]=false,["target"]="empty",["owner"]="meiya",["fatigue"]=20,["ap"]=3,["name"]="大王舞",["cd"]=2,["extended"]=true,["active"]=true,["uses_per_battle"]=2,["key"]="king_dance",["mastery"]="11级：疲劳成本减少15%，向下取整减免，至少减1；AP/冷却/每战次数不变",["mastery_fatigue"]=17},["read_beat"]={["owner"]="meiya",["icon"]="read_beat",["name"]="看懂节拍",["text"]="相邻队员单体近战落空时记住敌人；本轮下一次攻击该敌人近战命中 +6，每轮一次。",["extended"]=true,["active"]=false,["uses_per_battle"]=null,["ap"